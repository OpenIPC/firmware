# Grain Media GM8126 on a mainline kernel: gm8126_defconfig of
# openipc/linux grainmedia-gm8126, and what OpenIPC's userspace uses.
CONFIG_KERNEL_XZ=y
CONFIG_SYSVIPC=y
CONFIG_NO_HZ_IDLE=y
CONFIG_HIGH_RES_TIMERS=y
CONFIG_PREEMPT_NONE=y
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
CONFIG_LOG_BUF_SHIFT=16
CONFIG_BLK_DEV_INITRD=y
CONFIG_CC_OPTIMIZE_FOR_SIZE=y
CONFIG_EXPERT=y
CONFIG_ARCH_MULTI_V5=y
# CONFIG_ARCH_MULTI_V7 is not set
CONFIG_ARCH_GRAINMEDIA=y
CONFIG_AEABI=y
CONFIG_ARM_APPENDED_DTB=y
CONFIG_ARM_ATAG_DTB_COMPAT=y
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
CONFIG_PARTITION_ADVANCED=y
CONFIG_NET=y
CONFIG_PACKET=y
CONFIG_UNIX=y
CONFIG_INET=y
CONFIG_IP_PNP=y
CONFIG_IP_PNP_DHCP=y
# CONFIG_WIRELESS is not set
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_MTD=y
CONFIG_MTD_CMDLINE_PARTS=y
CONFIG_MTD_BLOCK=y
CONFIG_MTD_SPI_NOR=y
# CONFIG_MTD_SPI_NOR_USE_4K_SECTORS is not set
CONFIG_NETDEVICES=y
CONFIG_FTMAC100=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_OF_PLATFORM=y
CONFIG_I2C=y
CONFIG_I2C_CHARDEV=y
CONFIG_I2C_FTIIC010=y
CONFIG_SPI=y
CONFIG_SPI_FTSSP010=y
CONFIG_GPIO_FTGPIO010=y
CONFIG_WATCHDOG=y
CONFIG_FTWDT010_WATCHDOG=y
CONFIG_MMC=y
CONFIG_MMC_MOXART=y
CONFIG_PINCTRL=y
CONFIG_PINCTRL_SINGLE=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_TMPFS=y
CONFIG_JFFS2_FS=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_XZ=y
CONFIG_OVERLAY_FS=y
CONFIG_NFS_FS=y
CONFIG_VFAT_FS=y
# CONFIG_DEBUG_BUGVERBOSE is not set
# CONFIG_BPF_SYSCALL is not set
# CONFIG_CGROUPS is not set
# CONFIG_CROSS_MEMORY_ATTACH is not set
# CONFIG_DEBUG_KERNEL is not set
# CONFIG_DEBUG_MISC is not set
# CONFIG_DNOTIFY is not set
# CONFIG_ELF_CORE is not set
# CONFIG_ETHTOOL_NETLINK is not set
# CONFIG_FANOTIFY is not set
# CONFIG_FTRACE is not set
# CONFIG_HID_SUPPORT is not set
# CONFIG_HWMON is not set
# CONFIG_HW_RANDOM_VIRTIO is not set
# CONFIG_INET_DIAG is not set
# CONFIG_INPUT is not set
# CONFIG_IOSCHED_BFQ is not set
# CONFIG_IO_URING is not set
# CONFIG_IPV6 is not set
# CONFIG_KCMP is not set
# CONFIG_MQ_IOSCHED_DEADLINE is not set
# CONFIG_MQ_IOSCHED_KYBER is not set
# CONFIG_NAMESPACES is not set
# CONFIG_NET_SCHED is not set
# CONFIG_NET_VENDOR_CADENCE is not set
# CONFIG_NFS_V4 is not set
# CONFIG_POSIX_MQUEUE is not set
# CONFIG_PROFILING is not set
# CONFIG_RAS is not set
# CONFIG_RD_BZIP2 is not set
# CONFIG_RD_GZIP is not set
# CONFIG_RD_LZ4 is not set
# CONFIG_RD_LZMA is not set
# CONFIG_RD_LZO is not set
# CONFIG_RD_ZSTD is not set
# CONFIG_RSEQ is not set
# CONFIG_SCHED_DEBUG is not set
# CONFIG_SLUB_DEBUG is not set
# CONFIG_STACKTRACE is not set
# CONFIG_SUSPEND is not set
# CONFIG_SYMBOLIC_ERRNAME is not set
# CONFIG_USB_SUPPORT is not set
# CONFIG_VIRTIO_MENU is not set
# CONFIG_VT is not set
# CONFIG_WEXT_CORE is not set
CONFIG_LOCALVERSION=""
CONFIG_KALLSYMS=y
CONFIG_COREDUMP=y
CONFIG_UEVENT_HELPER=y
CONFIG_BLK_DEV_LOOP=m
CONFIG_TUN=m
CONFIG_WIREGUARD=m
CONFIG_EXT4_FS=m
# CONFIG_SWAP is not set
