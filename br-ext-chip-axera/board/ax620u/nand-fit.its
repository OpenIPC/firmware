/dts-v1/;

/*
 * Kernel of the AX620U NAND image: the zImage and its DTB, each hashed so
 * U-Boot refuses a kernel that NAND has corrupted instead of booting it.
 * Built by general/scripts/rootfs_script.sh (the "NAND FIT" step) from the
 * kernel tree; external.mk puts it in the UBIFS rootfs as /boot/fitImage.
 * Load addresses as in the stock AX620U FIT.
 */
/ {
	/* "OpenIPC <soc>": sysupgrade's SoC check reads it (fit_soc). */
	description = "OpenIPC @SOC@";
	#address-cells = <1>;

	images {
		kernel {
			description = "Linux";
			data = /incbin/("zImage");
			type = "kernel";
			arch = "arm";
			os = "linux";
			compression = "none";
			load = <0x40008000>;
			entry = <0x40008000>;
			hash-1 { algo = "crc32"; };
			hash-2 { algo = "sha1"; };
		};

		fdt {
			description = "ax620u";
			data = /incbin/("ax620u.dtb");
			type = "flat_dt";
			arch = "arm";
			compression = "none";
			load = <0x42008000>;
			hash-1 { algo = "crc32"; };
			hash-2 { algo = "sha1"; };
		};
	};

	configurations {
		default = "conf-1";
		conf-1 {
			description = "Linux + ax620u";
			kernel = "kernel";
			fdt = "fdt";
		};
	};
};
