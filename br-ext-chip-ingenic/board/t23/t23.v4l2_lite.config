CONFIG_OVERLAY_FS=y
CONFIG_VFAT_FS=m
CONFIG_EXFAT_FS=m
# CONFIG_PROC_PAGE_MONITOR is not set
CONFIG_TMPFS=y
CONFIG_JFFS2_FS=y
CONFIG_JFFS2_FS_XATTR=y
