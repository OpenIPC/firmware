CONFIG_USB=m
CONFIG_USB_ANNOUNCE_NEW_DEVICES=y
CONFIG_USB_DWC2=m
CONFIG_PHY_INGENIC_USB=m
CONFIG_MMC=m
CONFIG_MMC_JZ4740=m
CONFIG_NEW_LEDS=y
CONFIG_LEDS_CLASS=m
CONFIG_LEDS_GPIO=m
CONFIG_RTC_CLASS=y
CONFIG_RTC_DRV_JZ4740=m
CONFIG_DMADEVICES=y
CONFIG_DMA_JZ4780=y
# CONFIG_INGENIC_TIMER is not set
CONFIG_INGENIC_SYSOST=y
# CONFIG_IOMMU_SUPPORT is not set
CONFIG_REMOTEPROC=y
CONFIG_INGENIC_T23_REMOTEPROC=m
CONFIG_MEMORY=y
CONFIG_INGENIC_T23_DDR=y
CONFIG_IIO=m
CONFIG_INGENIC_T23_SADC=m
CONFIG_PWM=y
CONFIG_PWM_JZ4740=m
CONFIG_NVMEM_INGENIC_EFUSE=y
