CONFIG_SND_JZ4740_SOC_I2S=m
CONFIG_SND_SOC_INGENIC_T23_CODEC=m
CONFIG_SND_SOC_SIMPLE_AMPLIFIER=m
CONFIG_SND_SIMPLE_CARD=m
