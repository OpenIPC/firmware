/dts-v1/;

/*
 * Kernel of the gk7205v200-family NOR image: the zImage and its DTB, each
 * hashed so U-Boot refuses a kernel the flash has corrupted instead of booting
 * it. post-image.sh builds it from the kernel tree and packs firmware.bin: this
 * FIT, then the squashfs at the next 64 KiB boundary. The kernel splits the
 * one "firmware" partition U-Boot passes into kernel, rootfs and rootfs_data
 * (CONFIG_MTD_SPLIT_FIT_FW, CONFIG_MTD_SPLIT_SQUASHFS_ROOT), so neither image
 * has a slot of its own to fit.
 *
 * No fdt load address: U-Boot relocates the DTB under bootm_size, inside the
 * kernel's lowmem.
 */
/ {
	/* "OpenIPC <soc>": sysupgrade's SoC check reads it (fit_soc). */
	description = "OpenIPC @SOC@";
	#address-cells = <1>;

	images {
		kernel {
			description = "Linux";
			data = /incbin/("zImage");
			type = "kernel";
			arch = "arm";
			os = "linux";
			compression = "none";
			load = <0x40008000>;
			entry = <0x40008000>;
			hash-1 { algo = "crc32"; };
			hash-2 { algo = "sha1"; };
		};

		fdt {
			description = "@DTB@";
			data = /incbin/("@DTB@");
			type = "flat_dt";
			arch = "arm";
			compression = "none";
			hash-1 { algo = "crc32"; };
			hash-2 { algo = "sha1"; };
		};
	};

	configurations {
		default = "conf-1";
		conf-1 {
			description = "Linux + @DTB@";
			kernel = "kernel";
			fdt = "fdt";
		};
	};
};
