config BR2_PACKAGE_SIGMASTAR_OPENSDK
	bool "sigmastar-opensdk"
	depends on BR2_LINUX_KERNEL
	depends on BR2_OPENIPC_SOC_FAMILY = "infinity2m"
	help
	  SigmaStar kernel modules built from source, from OpenIPC's
	  opensigmastar: on infinity2m, the HDMI transmitter driver
	  (open_hdmitx.ko) and open_hdmi.ko, which switches the output on
	  from /sys/kernel/open_hdmi. Also provides the MI headers
	  applications build against.

	  https://github.com/OpenIPC/opensigmastar

comment "SIGMASTAR_OPENSDK needs a Linux kernel to be built"
	depends on !BR2_LINUX_KERNEL
