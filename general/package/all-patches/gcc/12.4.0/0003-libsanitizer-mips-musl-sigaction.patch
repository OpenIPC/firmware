libsanitizer: use the generic sigaction layout on musl/mips

__sanitizer_sigaction models struct sigaction, and three of its branches encode
glibc's mips layout: sa_flags leading the struct, sa_flags suppressed after
sa_mask, and a trailing sa_resv[1] on mips32. musl uses the same generic layout
on every architecture -- handler, sa_mask, sa_flags, sa_restorer -- so on a
mipsel musl target the model is wrong by four bytes and the build stops on its
own consistency checks:

    sanitizer_platform_limits_posix.cpp:1141: static assertion failed
      note: the comparison reduces to '(144 == 140)'

144 is glibc's, 140 is musl's. Gating all three on SANITIZER_GLIBC lets musl
fall through to the generic layout, which matches it exactly:
4 (handler) + 128 (sa_mask) + 4 (sa_flags) + 4 (sa_restorer) = 140.

This is not cosmetic. ASan intercepts sigaction() and reads these fields
through its own model, so a wrong offset would corrupt signal handling at
runtime rather than fail to compile -- which is what these assertions exist to
prevent, and why they should be satisfied rather than suppressed.

Signed-off-by: OpenIPC AI team <ai@openipc.org>

--- a/libsanitizer/sanitizer_common/sanitizer_platform_limits_posix.h
+++ b/libsanitizer/sanitizer_common/sanitizer_platform_limits_posix.h
@@ -638,7 +638,7 @@
 };
 #else // !SANITIZER_ANDROID
 struct __sanitizer_sigaction {
-#if defined(__mips__) && !SANITIZER_FREEBSD
+#if defined(__mips__) && !SANITIZER_FREEBSD && SANITIZER_GLIBC
   unsigned int sa_flags;
 #endif
   union {
@@ -654,7 +654,7 @@
 #else
   __sanitizer_sigset_t sa_mask;
 #endif
-#ifndef __mips__
+#if !defined(__mips__) || !SANITIZER_GLIBC
 #if defined(__sparc__)
 #if __GLIBC_PREREQ (2, 20)
   // On sparc glibc 2.19 and earlier sa_flags was unsigned long.
@@ -675,7 +675,7 @@
 #if SANITIZER_LINUX
   void (*sa_restorer)();
 #endif
-#if defined(__mips__) && (SANITIZER_WORDSIZE == 32)
+#if defined(__mips__) && (SANITIZER_WORDSIZE == 32) && SANITIZER_GLIBC
   int sa_resv[1];
 #endif
 #if defined(__s390x__)
