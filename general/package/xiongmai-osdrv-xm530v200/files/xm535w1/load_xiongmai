#!/bin/sh
# Loads the XM535W1 vendor modules, from a X2W-WNG, V5.00.R02.20240410 camera's
# firmware, in the order its own loadxm530 and loadpublic use.
MODULE=/lib/modules/3.10.103+/xiongmai

# MMZ is the RAM above the kernel's mem=. The camera's RAM size is not
# probed: OpenIPC's U-Boot keeps it in totalmem, and this chip's usual size
# is assumed without it.
MEM_ALL=$(fw_printenv -n totalmem 2>/dev/null | sed 's/[^0-9]//g')
[ -n "$MEM_ALL" ] || MEM_ALL=64
MEM_OS=$(awk '{print $1}' /proc/cmdline | sed -e 's/mem=//' -e 's/M//')
MEM_START=$(printf "0x%03x00000" $((0x800 + MEM_OS)))
MEM_LEN=$(printf "0x%03x00000" $((MEM_ALL - MEM_OS)))
echo MEM_START="$MEM_START" MEM_LEN="$MEM_LEN"


report_error() {
	echo "******* Error: There's something wrong, please check! *****"
	exit 1
}

# The vendor's pll.sh, through devmem instead of its regs tool
set_pll() {
	devmem 0x20000000 32 0x1
	devmem 0x2000011C 32 0x01590000
	sleep 0.1
	devmem 0x2000011C 32 0x1
	sleep 0.1
	devmem 0x20000124 32 0x0
	sleep 0.1
	devmem 0x20000124 32 0x3
	devmem 0x2000004C 32 0x61e
	devmem 0x20000054 32 0x05030503
	devmem 0x20000068 32 0x0e030603
	devmem 0x20000074 32 0x87020000
	devmem 0x20000078 32 0x85030000
	devmem 0x2000007C 32 0x8103
	sleep 0.1
	devmem 0x20000120 32 0x0
	sleep 0.1
	devmem 0x20000120 32 0x7
	devmem 0x20000000 32 0x0
	devmem 0x21400014 32 0x0
	devmem 0x21400014 32 0x1
	devmem 0x20050490 32 0x1
	devmem 0x20050540 32 0x1
	devmem 0x200505F0 32 0x1
	devmem 0x200506A0 32 0x1
	sleep 0.1
}

# MMZ: the open driver (open_mmz, the V200 series' allocator) where the
# image has it, the vendor's otherwise; an image with open_mmz keeps the
# vendor module outside the depmod tree.
insert_mmz() {
	vendor_mmz=mmz.ko
	[ -f "$vendor_mmz" ] || vendor_mmz=/usr/lib/xiongmai/mmz.ko
	modprobe open_mmz mmz_start="$MEM_START" mmz_size="$MEM_LEN" 2>/dev/null ||
		insmod "$vendor_mmz" mmz_start="$MEM_START" mmz_size="$MEM_LEN" ||
		report_error
}

insert_ko() {
	set_pll
	modprobe open_i2c 2>/dev/null || insmod i2c.ko
	insert_mmz
	modprobe open_vb 2>/dev/null || insmod /usr/lib/xiongmai/vb.ko 2>/dev/null || insmod vb.ko
	modprobe open_sys 2>/dev/null || insmod /usr/lib/xiongmai/sys.ko 2>/dev/null || insmod sys.ko
	modprobe open_log 2>/dev/null || insmod log.ko
	modprobe open_ddr 2>/dev/null || insmod ddr.ko
	modprobe open_vi line=0 2>/dev/null || insmod /usr/lib/xiongmai/vi.ko line=0 2>/dev/null || insmod vi.ko line=0
	modprobe open_isp 2>/dev/null || insmod isp.ko
	modprobe open_rgn 2>/dev/null || insmod /usr/lib/xiongmai/rgn.ko 2>/dev/null || insmod rgn.ko
	modprobe open_venc 2>/dev/null || insmod venc.ko
	modprobe open_h264 2>/dev/null || insmod h264.ko
	# the open driver where the image has it
	modprobe open_hevc 2>/dev/null || insmod hevc.ko
	modprobe open_nn 2>/dev/null || insmod nn.ko
	# The watchdog is the kernel's sp805_wdt (/dev/watchdog), not xm_wdt.ko:
	# see OpenIPC/firmware#2611.
	modprobe open_acodec 2>/dev/null || insmod acodec.ko
	modprobe open_i2s 2>/dev/null || insmod i2s.ko
	modprobe open_adc 2>/dev/null || insmod adc.ko
	# No SD card: the X2W-WNG has no slot, and its firmware ships no SD
	# module to take the pads from.
	# modprobe: a Wi-Fi profile (/etc/wireless/usb) may have loaded them already
	modprobe dwc2
	modprobe xm_usb0
}

remove_ko() {
	rmmod -w xm_usb0
	rmmod -w dwc2
	rmmod -w open_adc 2>/dev/null || rmmod -w adc
	rmmod -w open_i2s 2>/dev/null || rmmod -w i2s
	rmmod -w open_acodec 2>/dev/null || rmmod -w acodec
	rmmod -w open_nn 2>/dev/null || rmmod -w nn
	rmmod -w open_hevc 2>/dev/null || rmmod -w hevc
	rmmod -w open_h264 2>/dev/null || rmmod -w h264
	rmmod -w open_venc 2>/dev/null || rmmod -w venc
	rmmod -w open_rgn 2>/dev/null || rmmod -w rgn
	rmmod -w open_isp 2>/dev/null || rmmod -w isp
	rmmod -w open_vi 2>/dev/null || rmmod -w vi
	rmmod -w open_ddr 2>/dev/null || rmmod -w ddr
	rmmod -w open_log 2>/dev/null || rmmod -w log
	rmmod -w open_sys 2>/dev/null || rmmod -w sys
	rmmod -w open_vb 2>/dev/null || rmmod -w vb
	rmmod -w open_mmz 2>/dev/null || rmmod -w mmz
	rmmod -w open_i2c 2>/dev/null || rmmod -w i2c
}

load_usage() {
	echo "Usage: $0 [-option]"
	echo "options:"
	echo "    -i                  insert modules"
	echo "    -r                  remove modules"
	echo "    -h                  help information"
}

cd $MODULE || exit 1

if [ "$1" = "-i" ]; then
	insert_ko
fi

if [ "$1" = "-r" ]; then
	remove_ko
fi

if [ "$1" = "-h" ]; then
	load_usage
	exit
fi

if [ $# -eq 0 ] || [ "$1" = "-a" ]; then
	remove_ko
	insert_ko
fi
