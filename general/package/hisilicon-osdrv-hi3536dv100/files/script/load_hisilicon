#!/bin/sh
#
# This is part of OpenIPC.org project
#

# SoC detect
mem_start=0x80000000
mem_total=$(fw_printenv -n totalmem | tr -d 'M')
mem_total=${mem_total:=64}

# Prefer kernel cmdline mem=NM -- that's the authoritative kernel/MMZ split,
# but only when it's a strict subset of total RAM. With mmz_allocator=cma
# (V4 CMA layouts), bootargs typically pass mem=<totalmem> with the MMZ
# chunk CMA-reserved within that range; in that case mem= is no longer an
# OS/MMZ split and we must fall through to the U-Boot osmem env.
os_mem_size=$(awk 'BEGIN{RS=" "} /^mem=[0-9]+M/{gsub(/^mem=|M.*$/,""); print; exit}' /proc/cmdline)
if [ -n "$os_mem_size" ] && [ "$os_mem_size" -ge "$mem_total" ]; then
	os_mem_size=""
fi
if [ -z "$os_mem_size" ]; then
	os_mem_size=$(fw_printenv -n osmem | tr -d 'M')
fi
os_mem_size=${os_mem_size:=32}

mmz_start=0
mmz_size=0

MEM_ALL=256
MEM_START=0x800
MEM_SAMALL_LIN=0x1
MEM_MODE=0
b_arg_demb=1
VOU_LEN=22

report_error() {
  echo "******* Error: There's something wrong, please check! *****"
  exit 1
}

insert_wdt() {
  modprobe open_wdt
}

remove_wdt() {
  rmmod open_wdt
}

insert_audio() {
  modprobe open_aio
  modprobe open_ai
  modprobe open_ao
  modprobe open_aenc
  modprobe open_adec
  modprobe open_acodec
}

remove_audio() {
  rmmod open_acodec
  rmmod open_adec
  rmmod open_aenc
  rmmod open_ao
  rmmod open_ai
  rmmod open_aio
}

insert_ko() {
  HVRMEM=`cat /proc/cmdline  | awk '{print $1}' | sed s/mem=//`
  HVRMEM_OS=`echo $HVRMEM | sed s/M//`

  MEM_LEN=`echo "$MEM_ALL $HVRMEM_OS $VOU_LEN"|awk '{printf("%d",$1-$2-$3)}'`M
  VOU_START=`echo "$MEM_START $HVRMEM_OS $MEM_LEN "|awk '{printf("0x%03x00000",$1+$2+$3)}'`
  MEM_START=`echo "$MEM_START $MEM_SAMALL_LIN $HVRMEM_OS"|awk '{printf("0x%03x00000",$1+$2*$3)}'`
  VOU_LEN=`echo $VOU_LEN`M

  echo MEM_START=$MEM_START HVRMEM=$HVRMEM MEM_LEN=$MEM_LEN VOU_START=$VOU_START VOU_LEN=$VOU_LEN

  modprobe open_osal mmz=anonymous,0,$mmz_start,$mmz_size:vou,0,$VOU_START,$VOU_LEN anony=1 || report_error
  modprobe open_base
  modprobe open_sys mem_total=$mem_total
  if [[ $? -ne 0 ]]; then
    exit;
  fi

  modprobe open_vdec VBSource=0 u32ProtocolSwitch=0 StreamCompaMode=1 MiniBufMode=0
  modprobe open_vfmw
  modprobe open_jpegd
  modprobe open_tde
  modprobe open_region
  modprobe open_vgs

  modprobe open_vpss vpss_vb_source=0 vpss_en_ratio=0
  modprobe open_vou
  modprobe open_hifb video="hifb:vram0_size:8100,vram1_size:128" softcursor="off"
  modprobe open_hdmi
  modprobe open_venc
  modprobe open_chnl
  modprobe open_jpege

  insert_audio
  insert_wdt
  remove_wdt
}

remove_ko() {
  remove_audio
  remove_wdt

  rmmod open_jpege
  rmmod open_chnl
  rmmod open_venc
  rmmod open_hdmi
  rmmod open_hifb
  rmmod open_vou
  rmmod open_vpss
  rmmod open_vgs

  rmmod open_region
  rmmod open_tde
  rmmod open_jpegd
  # vdec before vfmw, as the SDK's own load3536dv100 does: vdec's
  # HI_VFMW_VideoDe thread runs vfmw code, and with vfmw gone first it jumps
  # into freed module text (a kernel oops, then another in vdec's exit).
  rmmod open_vdec
  rmmod open_vfmw
  rmmod open_sys
  rmmod open_base
  rmmod open_osal
}

load_usage() {
  echo "Usage:  ./load_hisilicon [-option]"
  echo "options:"
  echo "  -i  - insert modules"
  echo "  -r  - remove modules"
  echo "  -a  - remove first and then insert modules"
}

calc_mmz_info() {
  mmz_start=`echo "$mem_start $os_mem_size" | 
  awk 'BEGIN { temp = 0; }
  {
    temp = $1/1024/1024 + $2;
  }
  END { printf("0x%x00000\n", temp); }'`

  mmz_size=`echo "$mem_total $os_mem_size" | 
  awk 'BEGIN { temp = 0; }
  {
    temp = $1 - $2;
  } 
  END { printf("%dM\n", temp); }'`
  echo "mmz_start: $mmz_start, mmz_size: $mmz_size"
}


######################parse arg###################################
b_arg_insmod=0
b_arg_remove=0

for arg in $@; do
  case $arg in
  "-i")
    b_arg_insmod=1
  ;;
  "-r")
    b_arg_remove=1
  ;;
  "-a")
    b_arg_insmod=1
    b_arg_remove=1
  ;;
  "-h")
    load_usage
  ;;
  esac
done
#######################parse arg end########################

if [ $os_mem_size -ge $mem_total ]; then
  echo "[err] os_mem[$os_mem_size], over total_mem[$mem_total]"
  exit
fi

calc_mmz_info

#######################Action###############################

if [ $# -lt 1 ]; then
  load_usage
  exit 0
fi

# - Remove modules
if [ $b_arg_remove -eq 1 ]; then
  remove_ko
fi

# - Insert modules
if [ $b_arg_insmod -eq 1 ]; then
  cd /lib/modules/4.9.37/hisilicon
  insert_ko
fi
