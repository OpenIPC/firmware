#!/bin/sh
#
# This is part of OpenIPC.org project | 2026.03.01
#

SNS_TYPE0=sc450ai;
SNS_TYPE1=sc450ai;
SNS_SET0=0
SNS_SET1=0
SYS_PROFILE=0
IR_AUTO=0
DEBUG=1
BOARD=dmeb_qfn; # dmeb_qfn dmeb_bga

# SoC detect
chipid=$(ipcinfo --chip-name)
socmodel=$(fw_printenv -n socmodel)

# Memory config
proc_cmdline=${LOAD_HISILICON_CMDLINE:-/proc/cmdline}
mem_start=$(grep "System RAM" ${LOAD_HISILICON_IOMEM:-/proc/iomem} | awk -F'[- :]' '{print "0x"$1}')

# A kernel that measures DRAM and lays it out itself (hisi_mem, OpenIPC/linux)
# publishes the result: the DRAM size and OS share in MiB, the allocator, and
# the zone as open_mmz takes it. Its layout is the one this boot runs with,
# under any bootloader, so nothing below reads or writes the U-Boot environment.
hisi_mem=${LOAD_HISILICON_MEM:-/sys/module/hisi_mem/parameters}
kernel_alloc=$(cat "$hisi_mem/allocator" 2>/dev/null)
if [ -n "$kernel_alloc" ]; then
	mem_total=$(cat "$hisi_mem/dram")
	os_mem_size=$(cat "$hisi_mem/osmem")
	kernel_mmz=$(cat "$hisi_mem/mmz")
else
	mem_total=$(fw_printenv -n totalmem | tr -d 'M')
	mem_total=${mem_total:=64}

	os_mem_size=$(awk 'BEGIN{RS=" "} /^mem=[0-9]+M/{gsub(/^mem=|M.*$/,""); print; exit}' $proc_cmdline)
	if [ -n "$os_mem_size" ] && [ "$os_mem_size" -ge "$mem_total" ]; then
		os_mem_size=""
	fi
	if [ -z "$os_mem_size" ]; then
		os_mem_size=$(fw_printenv -n osmem | tr -d 'M')
	fi
	os_mem_size=${os_mem_size:=32}
fi

report_error() {
	echo "******* Error: There's something wrong, please check! *****"
	exit 1
}

insert_osal() {
	modprobe open_osal proc_show=${DEBUG}
	modprobe open_mmz $mmz_args mem_process_isolation=$((1 - DEBUG)) || report_error
}

function insert_audio()
{
	modprobe open_aio
	modprobe open_ai
	modprobe open_ao
	modprobe open_aenc
	modprobe open_adec
	modprobe open_acodec
}

function remove_audio()
{
	rmmod open_acodec
	rmmod open_adec
	rmmod open_aenc
	rmmod open_ao
	rmmod open_ai
	rmmod open_aio
}

function insert_security_subsys()
{
	# open_cipher and open_km are V5 closed-source security blobs not yet
	# in the openhisilicon set — modprobe will return non-zero if missing.
	# Run best-effort so the rest of the MPP pipeline still comes up.
	modprobe open_cipher 2>/dev/null
	modprobe open_km 2>/dev/null
}

function remove_security_subsys()
{
	rmmod open_km 2>/dev/null
	rmmod open_cipher 2>/dev/null
}

function insert_detect()
{
	# Minimal module set sufficient for `ipcinfo --short-sensor` probe.
	# Mirrors ev200's insert_detect() — avoids paying the full MPP
	# bring-up cost during sensor auto-detect (~3 sec vs ~15 sec).
	modprobe open_sys_config sensors=sns0=$SNS_TYPE0,sns1=$SNS_TYPE1 board=$BOARD ir_auto=$IR_AUTO
	insert_osal
	modprobe open_base logmpp_show=${DEBUG}
	modprobe open_isp
	modprobe open_sensor_i2c
	modprobe open_sensor_spi 2>/dev/null
}

function remove_detect()
{
	rmmod open_sensor_spi 2>/dev/null
	rmmod open_sensor_i2c 2>/dev/null
	rmmod open_isp
	rmmod open_base
	rmmod open_mmz
	rmmod open_osal
	rmmod open_sys_config
}

insert_ko() {
	# sys config
	modprobe open_sys_config sensors=sns0=$SNS_TYPE0,sns1=$SNS_TYPE1 board=$BOARD ir_auto=$IR_AUTO $(vo_sys_config_arg)
	# driver load
	insert_osal
	modprobe open_base logmpp_show=${DEBUG}
	modprobe open_vb
	modprobe open_vca
	modprobe open_sys profile=$SYS_PROFILE
	modprobe open_rgn
	modprobe open_vpp
	modprobe open_vgs
	modprobe open_vpss
	modprobe open_vi
	modprobe open_isp
	modprobe open_chnl
	modprobe open_rc
	modprobe open_venc g_venc_max_chn_num=8
	# The encoders' venc server, between venc and the encoders as the SDK's
	# load3519dv500 has it. Without it the first encoder call majestic makes
	# (VENC get mod param) is a NULL dereference in open_venc and a panic.
	modprobe open_venc_svr
	modprobe open_h264e
	modprobe open_h265e

	case ${socmodel} in 20g|00s|00g) modprobe open_svac3e ;; esac
	# modprobe open_svac3e
	modprobe open_jpege
	modprobe open_svp_npu
	modprobe open_ive save_power=1
	modprobe open_pwm
	modprobe open_piris
	modprobe open_sensor_i2c
	modprobe open_sensor_spi 2>/dev/null

	insert_audio
	insert_vo
	modprobe open_mipi_rx
	# modprobe open_user
	case ${socmodel} in 20s|20g|00s|00g) modprobe open_aiisp ;; esac
	# modprobe open_uvc
	modprobe open_pm
	modprobe open_wdt
	insert_security_subsys
}

remove_ko() {
	remove_security_subsys
	rmmod open_wdt 2>/dev/null
	rmmod open_pm
	# rmmod open_uvc
	rmmod open_aiisp &> /dev/null
	# rmmod open_user
	rmmod open_mipi_rx

	remove_vo
	remove_audio
	rmmod open_sensor_spi &> /dev/null
	rmmod open_sensor_i2c &> /dev/null
	rmmod open_piris 2>/dev/null
	rmmod open_pwm 2>/dev/null
	rmmod open_ive
	rmmod open_svp_npu
	rmmod open_jpege
	rmmod open_h265e
	rmmod open_svac3e &> /dev/null
	rmmod open_h264e
	rmmod open_venc_svr
	rmmod open_venc
	rmmod open_rc
	rmmod open_chnl
	rmmod open_vpss
	rmmod open_isp
	rmmod open_vi
	rmmod open_vgs
	rmmod open_vpp
	rmmod open_rgn
	rmmod open_sys
	rmmod open_vca
	rmmod open_vb
	rmmod open_base
	rmmod open_mmz
	rmmod open_osal

	rmmod open_sys_config
}

load_usage()
{
	echo "Usage:  $0 [-option] [-sensor0~1] "
	echo "options:"
	echo "    -i                       insert modules"
	echo "    -r                       remove modules"
	echo "    -a                       remove modules first, then insert modules"
	echo "    -sensor0~1 sensor_name   config sensor type    [default: sc4336p]"
	echo "    -mmz_start               config MMZ start addr [default: 0x42000000]"
	echo "    -mmz_size                config MMZ mem size [unit: M, default: 96M]"
	echo "    -ir_auto                 config ir_auto enable [default: 0]"
	echo "    -profile                 config sys_profile [default: 0]"
	echo "    -h                       help information"
	echo -e "Available sensors:sc4336p gc4023 sc450ai sc500ai sc431hai os04d10 imx307 os02m10 bt1120/bt656/bt601"
	echo -e "for example: $0 -i -sensor0 sc4336p -sensor1 sc4336p -mmz_start 0x42000000 -mmz_size 96M -ir_auto 1\n"
}

# The sensor on the SENSOR1 connector. majestic finds it by probing each
# connector's bus, and the probe above names the first sensor it finds, so
# SENSOR1's port gets the same sensor type as SENSOR0's -- right for any pair
# that shares a master clock (os04a10, os08a20: 0x4001). A sensor on SENSOR1
# that needs another can be named in the environment:
#   fw_setenv sensor1 sc450ai
# -sensor1 on the command line wins over the environment.
sensor1_from_env() {
	[ $SNS_SET1 -eq 1 ] && return 0
	env_sensor1=$(fw_printenv -n sensor1 2>/dev/null || true)
	if [ -n "$env_sensor1" ]; then
		SNS_TYPE1=$env_sensor1
		SNS_SET1=1
		logger -s -p daemon.info -t hisilicon "Get data from environment and set SENSOR1 as ${SNS_TYPE1}"
	fi
}

# SENSOR1 is controlled over I2C5, whose pins (iocfg 0x0EFF0024/0x0EFF0028)
# come up as GPIO: open_sys_config is built without I2C_EX_EN and leaves them
# at 0x1300, while SENSOR1's clock and reset pins it does mux. majestic muxes
# them itself when it finds a sensor there; for a sensor named in the
# environment they are muxed here as well, so it answers from the start.
sensor1_pinmux() {
	[ $SNS_SET1 -eq 1 ] || return 0
	devmem 0x0EFF0024 32 0x1752	# I2C5_SCL
	devmem 0x0EFF0028 32 0x1752	# I2C5_SDA
}

# Video output. VO_INTF is the interface open_sys_config muxes the pins for;
# empty means none, and then nothing below loads and the pins are left as they
# were, which is every camera without a display.
VO_INTF=

# The demo boards' HDMI adapter: a Lontium LT8618SXB BT.1120-to-HDMI bridge on
# I2C7 at 0x39, fed by VO over BT.1120. Its chip ID is 0x17 0x02 at registers
# 0x00/0x01 of bank 0x80. From power-on those read 0x00 until 0xff selects the
# bank and 0xee enables the registers (measured after a power cycle), so the
# ID cannot be read without those two writes.
#
# The probe leaves any other device as it found it. Nothing is written unless
# something answers at 0x39; 0xff and 0xee are read before they are written,
# and when the ID is not the bridge's they get their old values back.
#
# I2C7's pads are set first, because the probe runs before open_sys_config
# loads; they get the value open_sys_config writes on every board anyway.
hdmi_bridge_present() {
	local bank enable id
	devmem 0x179F0000 32 0x1012	# I2C7_SDA
	devmem 0x179F0004 32 0x1012	# I2C7_SCL
	bank=$(i2cget -y 7 0x39 0xff 2> /dev/null) || return 1
	enable=$(i2cget -y 7 0x39 0xee 2> /dev/null) || return 1
	i2cset -y 7 0x39 0xff 0x80 2> /dev/null || return 1
	i2cset -y 7 0x39 0xee 0x01 2> /dev/null
	id="$(i2cget -y 7 0x39 0x00 2> /dev/null) $(i2cget -y 7 0x39 0x01 2> /dev/null)"
	[ "$id" = "0x17 0x02" ] && return 0
	i2cset -y 7 0x39 0xee "$enable" 2> /dev/null
	i2cset -y 7 0x39 0xff "$bank" 2> /dev/null
	return 1
}

# BT.1120 takes over pins that are SDIO1, I2C0 and the MIPI DSI lanes
# elsewhere, so it is chosen only when the bridge answers, or when the
# environment says so:
#   fw_setenv vo_intf bt1120     (or mipi_tx, bt656, rgb...)
#   fw_setenv vo_intf none       no video output, even with the bridge fitted
resolve_vo() {
	env_vo=$(fw_printenv -n vo_intf 2>/dev/null || true)
	if [ -n "$env_vo" ]; then
		[ "$env_vo" = "none" ] || VO_INTF=$env_vo
		logger -s -p daemon.info -t hisilicon "Video output ${env_vo} from the environment"
	elif hdmi_bridge_present; then
		VO_INTF=bt1120
		logger -s -p daemon.info -t hisilicon "HDMI bridge (LT8618SXB) answers on I2C7, video output over BT.1120"
	fi
}

vo_sys_config_arg() {
	[ -n "$VO_INTF" ] && echo "vo_intf=$VO_INTF"
}

# open_vo_dev before open_vo, as the SDK's load3519dv500 has them. The bridge
# driver programs the LT8618SXB at load and refuses to load without one. That
# is logged, with what modprobe said, and the boot goes on: the camera streams
# whether or not the HDMI output can be driven.
insert_vo() {
	local err
	[ -n "$VO_INTF" ] || return 0
	modprobe open_vo_dev
	modprobe open_vo
	case $VO_INTF in
		bt1120 | bt.1120)
			if ! err=$(modprobe open_lt8618sx 2>&1); then
				logger -s -p daemon.err -t hisilicon "The HDMI bridge driver did not load, so HDMI stays dark: ${err:-no reason given}"
			fi
			;;
		mipi_tx | mipitx) modprobe open_mipi_tx ;;
	esac
}

remove_vo() {
	rmmod open_lt8618sx 2>/dev/null
	rmmod open_mipi_tx 2>/dev/null
	rmmod open_vo 2>/dev/null
	rmmod open_vo_dev 2>/dev/null
}

calc_mmz_info() {
	mmz_start=$(echo "$mem_start $os_mem_size" |
		awk 'BEGIN { temp = 0; }
		{
				temp = $1/1024/1024 + $2;
		}
		END { printf("0x%x00000\n", temp); }')

	mmz_size=$(echo "$mem_total $os_mem_size" |
		awk 'BEGIN { temp = 0; }
		{
				temp = $1 - $2;
		}
		END { printf("%dM\n", temp); }')
	echo "mmz_start: $mmz_start, mmz_size: $mmz_size"
}

b_arg_modprobe=0
b_arg_remove=0
function parse_arg()
{
	######################parse arg###################################
	b_arg_sensor0=0
	b_arg_sensor1=0
	b_arg_mmz_start=0
	b_arg_mmz_size=0
	b_arg_ir_auto=0
	b_arg_profile=0

	for arg in $@
	do
		if [ $b_arg_sensor0 -eq 1 ] ; then
			b_arg_sensor0=0;
			SNS_TYPE0=$arg;
			SNS_SET0=1
			# Mirror ev200: explicit sensor flag also seeds SENSOR
			# so the auto-detect probe path is skipped.
			export SENSOR=$arg
		fi
		if [ $b_arg_sensor1 -eq 1 ] ; then
			b_arg_sensor1=0;
			SNS_TYPE1=$arg;
			SNS_SET1=1
		fi

		if [ $b_arg_ir_auto -eq 1 ] ; then
			b_arg_ir_auto=0;
			IR_AUTO=$arg;
		fi

		if [ $b_arg_mmz_start -eq 1 ] ; then
			b_arg_mmz_start=0;
			mmz_start=$arg;

			if [ -z $mmz_start ]; then
				echo "[error] mmz_start is null"
				exit;
			fi
		fi

		if [ $b_arg_mmz_size -eq 1 ] ; then
			b_arg_mmz_size=0;
			mmz_size=$arg;

			if [ -z $mmz_size ]; then
				echo "[error] mmz_size is null"
				exit;
			fi
		fi

		if [ $b_arg_profile -eq 1 ] ; then
			b_arg_profile=0;
			SYS_PROFILE=$arg;
		fi

		case $arg in
			"-i")
				b_arg_modprobe=1;
				;;
			"-r")
				b_arg_remove=1;
				;;
			"-a")
				b_arg_modprobe=1;
				b_arg_remove=1;
				;;
			"-h")
				load_usage;
				;;
			"-sensor0")
				b_arg_sensor0=1;
				;;
			"-sensor")
				b_arg_sensor0=1;
				;;
			"-sensor1")
				b_arg_sensor1=1;
				;;
			"-ir_auto")
				b_arg_ir_auto=1;
				;;
			"-mmz_size")
				b_arg_mmz_size=1;
				;;
			"-mmz_start")
				b_arg_mmz_start=1;
				;;
			"-profile")
				b_arg_profile=1;
				;;
		esac
	done
	#######################parse arg end########################
}

if [ $# -lt 1 ]; then
	load_usage;
	exit 0;
fi

parse_arg $@

#######################Action###############################
if [ $b_arg_remove -eq 1 ]; then
	remove_ko;
fi
#######################parse arg end########################
if [ -n "$kernel_alloc" ]; then
	echo "Memory laid out by the kernel: DRAM ${mem_total}M, OS ${os_mem_size}M, ${kernel_alloc}"
	mmz_args="anony=1 mmz_allocator=$kernel_alloc mmz=$kernel_mmz"
else
	if [ $os_mem_size -ge $mem_total ]; then
		echo "[err] os_mem[$os_mem_size], over total_mem[$mem_total]"
		exit
	fi

	calc_mmz_info
	MMZ=$(awk -F '=' '$1=="mmz"{print $2}' RS=" " $proc_cmdline)
	if [ -z "$MMZ" ]; then
		mmz_args="anony=1 mmz_allocator=ot mmz=anonymous,0,$mmz_start,$mmz_size"
	else
		mmz_args="anony=1 mmz_allocator=cma mmz=$MMZ"
	fi
fi
echo "mmz: $mmz_args"

# The sensors on this board plug in with ribbon cables and get swapped, so the
# name saved on an earlier boot -- the u-boot `sensor` variable, which rcS also
# exports as SENSOR -- is checked against the bus on every boot. What answers
# now wins, and is saved when it differs; the saved name stands only when
# nothing answers (a sensor ipcinfo does not know), so a camera that worked
# keeps working. -sensor0 on the command line is taken as given, unprobed.
# The probe costs about 3 s. A saved "unknown" is a failed probe from before
# #2428 and is dropped.
resolve_sensor() {
	local saved detected
	[ "$SENSOR" = "unknown" ] && SENSOR=
	saved=$(fw_printenv -n sensor 2>/dev/null)
	if [ "$saved" = "unknown" ]; then
		fw_setenv sensor
		saved=
	fi
	if [ $SNS_SET0 -eq 1 ]; then
		logger -s -p daemon.info -t hisilicon "Manualy set SENSOR as ${SENSOR}"
		return 0
	fi
	[ -z "$SENSOR" ] && SENSOR=$saved

	insert_detect
	detected=$(ipcinfo --short-sensor)
	remove_detect

	if [ -n "$detected" ] && [ "$detected" != "unknown" ]; then
		if [ -n "$SENSOR" ] && [ "$SENSOR" != "$detected" ]; then
			logger -s -p daemon.info -t hisilicon "Sensor changed: ${SENSOR} was saved, ${detected} answers"
		fi
		SENSOR=$detected
		logger -s -p daemon.info -t hisilicon "Get data from ipcinfo and set SENSOR as ${SENSOR}"
		if [ "$saved" != "$SENSOR" ]; then
			fw_setenv sensor $SENSOR && logger -s -p daemon.info -t hisilicon "Write detected ${SENSOR} to U-Boot ENV"
		fi
	elif [ -n "$SENSOR" ]; then
		logger -s -p daemon.info -t hisilicon "No sensor answered; keeping ${SENSOR} from the environment"
	else
		SENSOR=unknown
	fi
}

resolve_sensor
export SENSOR

if [ "$SENSOR" = "unknown" ]; then
	exit 1
else
	# open_sys_config takes each port's master clock from the sensor name
	# (0x4001 for os04a10/os08a20, 0xA001 for sc450ai/sc850sl). The defaults
	# are only good for the auto-detect probe above, so give it the sensor
	# this boot resolved unless -sensor0/-sensor1 named one, as hi3516cv6xx
	# does.
	sensor1_from_env
	[ $SNS_SET0 -eq 0 ] && SNS_TYPE0=$SENSOR
	[ $SNS_SET1 -eq 0 ] && SNS_TYPE1=$SENSOR
	if [ $b_arg_modprobe -eq 1 ]; then
		cd /lib/modules/$(uname -r)/hisilicon
		resolve_vo
		insert_ko
		sensor1_pinmux
	fi
fi
