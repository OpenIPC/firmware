#!/bin/sh
# Feed the hardware watchdog the vendor U-Boot arms before the kernel starts.
#
# The AK3918AV100 vendor U-Boot (2019.10.0-V4.0.21 on the camera tested)
# starts the watchdog as part of every boot. Nothing on these lite images
# feeds it: the lite variant ships no majestic, and the Anyka driver runs no
# kernel-side daemon -- only a userspace write to /dev/watchdog pets it, and
# only holding the device open pets it for long. Measured on an oQo ICF001
# (AK3918AV100N): with nothing opening the device, the camera hard-resets
# 55-60 s after U-Boot starts, on every boot, with no panic or oops on the
# console. The vendor's own stock firmware feeds the same device from
# busybox's watchdog applet, which is what this does.
#
# -T 357 asks the driver for the longest window it accepts: its
# WDIOC_SETTIMEOUT clamps at 357, the AnyCloud SDK's MAX_FEED_DOG. -t 1
# writes every second, far inside any plausible heartbeat the driver could
# end up running with -- each write re-arms the timer with the heartbeat the
# device tree names.
#
# On stop, kill the feeder but do not try to disarm the dog: the kernel is
# built with WATCHDOG_NOWAYOUT, so closing the device cannot stop it anyway,
# and a reset that bites during a wedged shutdown recovers the camera. That
# is the same trade sysupgrade's own keeper makes.

case "$1" in
	start)
		[ -c /dev/watchdog ] || exit 0
		command -v watchdog >/dev/null 2>&1 || exit 0
		# The applet dies nonzero before daemonizing if it cannot open the
		# device or set the timeout: say so, or the boot log shows success
		# while the armed timer counts down unfed.
		if watchdog -t 1 -T 357 /dev/watchdog; then
			logger -s -p daemon.info -t watchdog \
				"feeding /dev/watchdog (interval 1s, timeout 357s)"
		else
			logger -s -p daemon.err -t watchdog \
				"failed to start feeding /dev/watchdog: the armed vendor watchdog stays unfed"
			exit 1
		fi
		;;
	stop)
		# No magic close: the dog stays armed across the reboot on purpose.
		killall watchdog 2>/dev/null
		;;
	*)
		echo "Usage: $0 {start|stop}"
		exit 1
		;;
esac
