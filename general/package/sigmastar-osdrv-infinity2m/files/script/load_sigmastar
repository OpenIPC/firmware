#!/bin/sh
#
# OpenIPC.org | 2026
#
# infinity2m (SSR621Q NVR): the SigmaStar media stack for decoding to the
# display, as OpenIPC/opensigmastar builds it (sigmastar-opensdk): the SDK's
# modules relinked for this kernel (open_mhal, open_mi_*, open_fbdev) and the
# HDMI transmitter from source. They read their configuration from /config
# (panel timings, PQ, memory map, decoder firmware), a path built into them.
#
# load_sigmastar [-i]    load (S70vendor passes -i)
# load_sigmastar -r      unload

MODULE=/lib/modules/4.9.84/sigmastar
# MI modules in the SDK's dependency order; each gets /dev/<name>
MI="mi_sys mi_ao mi_gfx mi_divp mi_vdec mi_ai mi_disp mi_panel"

insert_ko() {
	insmod $MODULE/open_mhal.ko || return 1
	insmod $MODULE/open_mi_common.ko || return 1
	major=$(awk '$2=="mi" {print $1}' /proc/devices)
	minor=0
	for m in $MI; do
		if insmod $MODULE/open_$m.ko; then
			[ -e /dev/$m ] || mknod /dev/$m c "$major" $minor
			minor=$((minor + 1))
		else
			echo "load_sigmastar: $m failed" | logger -s -t OpenIPC
		fi
	done
	major=$(awk '$2=="mi_poll" {print $1}' /proc/devices)
	[ -n "$major" ] && [ ! -e /dev/mi_poll ] && mknod /dev/mi_poll c "$major" 0
	insmod $MODULE/open_fbdev.ko default_config_path_file=/config/fbdev.ini

	# HDMI transmitter, built from source; the application switches it
	# on with /sys/kernel/open_hdmi/output
	insmod $MODULE/open_hdmitx.ko && insmod $MODULE/open_hdmi.ko
}

remove_ko() {
	for m in open_hdmi open_hdmitx open_fbdev open_mi_panel open_mi_disp \
		open_mi_ai open_mi_vdec open_mi_divp open_mi_gfx open_mi_ao \
		open_mi_sys open_mi_common open_mhal; do
		[ -e /sys/module/$m ] && rmmod $m
	done
}

case "$1" in
	-r)
		remove_ko
		;;
	*)
		[ -e /sys/module/open_mi_common ] || insert_ko
		;;
esac
