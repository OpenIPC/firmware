#!/bin/sh
#
# OpenIPC.org | 2026
#
# infinity2m (SSR621Q NVR): the SigmaStar media stack for decoding to the
# display, as OpenIPC/opensigmastar builds it (sigmastar-opensdk): the SDK's
# modules relinked for this kernel (open_mhal, open_mi_*, open_fbdev) and the
# HDMI transmitter from source. They read their configuration from /config
# (panel timings, PQ, memory map, decoder firmware), a path built into them.
#
# load_sigmastar [-i]    load (S70vendor passes -i)
# load_sigmastar -r      unload (for debugging: the SDK modules leave timers
#                        armed, and the kernel can oops after it)

MODULE=/lib/modules/4.9.84/sigmastar
# MI modules in the SDK's dependency order; each gets /dev/<name>
MI="mi_sys mi_ao mi_gfx mi_divp mi_vdec mi_ai mi_disp mi_panel"
# Everything an NVR needs, in load order; -r unloads in reverse
ALL="open_mhal open_mi_common $(for m in $MI; do printf 'open_%s ' $m; done)open_fbdev open_hdmitx open_hdmi"

log() {
	echo "load_sigmastar: $*" | logger -s -t OpenIPC
}

# Load one module unless it is already there, so a run after a failed one
# completes the stack instead of stopping at what is loaded. Nothing is
# unloaded on failure: the SDK modules leave timers armed when removed.
load() {
	m=$1
	shift
	[ -e /sys/module/$m ] && return 0
	insmod $MODULE/$m.ko "$@" || { log "$m failed"; return 1; }
}

insert_ko() {
	load open_mhal || return 1
	load open_mi_common || return 1
	major=$(awk '$2=="mi" {print $1}' /proc/devices)
	minor=0
	for m in $MI; do
		load open_$m || return 1
		[ -e /dev/$m ] || mknod /dev/$m c "$major" $minor
		minor=$((minor + 1))
	done
	major=$(awk '$2=="mi_poll" {print $1}' /proc/devices)
	[ -n "$major" ] && [ ! -e /dev/mi_poll ] && mknod /dev/mi_poll c "$major" 0
	load open_fbdev default_config_path_file=/config/fbdev.ini || return 1

	# HDMI transmitter, built from source; the application switches it
	# on with /sys/kernel/open_hdmi/output
	load open_hdmitx || return 1
	load open_hdmi
}

remove_ko() {
	for m in $(echo $ALL | tr ' ' '\n' | sed -n '1!G;h;$p'); do
		[ -e /sys/module/$m ] && rmmod $m
	done
}

case "$1" in
	-r)
		remove_ko
		;;
	*)
		if ! insert_ko; then
			log "media stack incomplete"
			exit 1
		fi
		;;
esac
