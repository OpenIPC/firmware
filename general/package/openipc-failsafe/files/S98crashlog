#!/bin/sh
# After a crash, preserve the pstore log where the WebUI can offer it to the
# owner, then free the pstore ring for the next one. pstore itself survives a
# warm reset but not a cold power-cycle; copying the record into the overlay
# lets the notice and the download outlive the plug being pulled. A clean boot
# -- no records -- writes nothing at all. This is the capture half of the
# owner-pull crash report (the WebUI is the other half, and with the owner's
# say-so sends it to openipc.org, which files crashes from every camera by bug);
# it pairs with the failsafe breadcrumb in failsafe-rescue and with S99bootok.
#
# The latest crash is crash.tar.gz, which is what the WebUI shows and sends.
# The ones before it that the owner has not dismissed are kept under older/,
# at most KEEP of them, the oldest dropped first: a camera that crashed twice
# before anyone looked used to keep only the second, and a bug that shows up
# once in two crashes is half as likely to be seen. The cap keeps the overlay
# from growing without bound; each bundle is a few kilobytes.
#
# Each bundle carries meta.json beside the records: what was running when the
# crash was harvested -- firmware build, kernel, command line, chip, sensor --
# and the camera's majestic settings that differ from the
# defaults, limited to the sections that shape the video pipeline and without
# anything that names an account, a server or a secret. That is what it takes
# to reproduce a crash on another camera of the same kind. The harvest runs on
# the boot after the crash, so a sysupgrade in between shows as a kernel in
# meta.json that differs from the one in the records' own banner.
case "$1" in
	start|"") ;;
	*) exit 0 ;;
esac

PSTORE=/sys/fs/pstore
CRASH=/etc/crash
KEEP=2

# Nothing captured last boot -> ordinary boot, leave no trace.
ls "$PSTORE"/dmesg-* >/dev/null 2>&1 || exit 0
mkdir -p "$CRASH" 2>/dev/null || exit 0

# A harvest cut short by a reset after the bundle was published but before
# pstore was freed finds the same records again: they are in crash.tar.gz
# already, so it only frees pstore. Rotating them would keep one crash twice
# and could push a different one out past KEEP. The bundle itself is what is
# compared, not a note about it, so no moment of the harvest is unsafe to be
# reset in.
same_records() {
	[ -s "$CRASH/crash.tar.gz" ] || return 1
	check=$CRASH/check
	rm -rf "$check"
	mkdir "$check" 2>/dev/null || return 1
	gzip -dc "$CRASH/crash.tar.gz" > "$check/bundle.tar" 2>/dev/null &&
		tar xf "$check/bundle.tar" -C "$check" 2>/dev/null &&
		[ "$(cd "$check" && cat dmesg-* 2>/dev/null | md5sum)" = "$(cd "$PSTORE" && cat dmesg-* 2>/dev/null | md5sum)" ]
	same=$?
	rm -rf "$check"
	return $same
}
if same_records; then
	rm -f "$PSTORE"/dmesg-* 2>/dev/null
	exit 0
fi

# A JSON string, from anything a shell variable can hold.
jstr() {
	awk 'BEGIN {
		s = ARGV[1]
		gsub(/\\/, "\\\\", s); gsub(/"/, "\\\"", s); gsub(/\t/, "\\t", s)
		gsub(/[\001-\037]/, "", s)
		printf "\"%s\"", s
	}' "$1"
}

# The settings that shape the pipeline, as majestic.yaml holds them: only
# what differs from the defaults, and only these sections. Within them a key
# that names a credential, an address or the owner's own text is dropped,
# value and all.
config_lines() {
	[ -r /etc/majestic.yaml ] || { printf '[]'; return; }
	awk '
		BEGIN {
			split("isp image video0 video1 jpeg mjpeg osd audio nightMode motionDetect records hls rtsp", a, " ")
			for (i in a) keep[a[i]] = 1
			printf "["
		}
		/^[ \t]*#/ || /^[ \t]*$/ { next }
		/^[^ \t]/ { section = $0; sub(/:.*/, "", section) }
		!(section in keep) { next }
		tolower($0) ~ /(pass|token|secret|key|user|login|email|url|uri|server|host|ssid|psk|template|text)[a-z0-9]*[ \t]*:/ { next }
		{
			s = $0
			gsub(/\\/, "\\\\", s); gsub(/"/, "\\\"", s); gsub(/\t/, "  ", s)
			gsub(/[\001-\037]/, "", s)
			printf "%s\"%s\"", (n++ ? "," : ""), s
		}
		END { printf "]" }
	' /etc/majestic.yaml
}

os_value() {
	sed -n "s/^$1=//p" /etc/os-release 2>/dev/null | tr -d '"' | head -n 1
}

# Not majestic's version: this runs while S95majestic is bringing the daemon
# up, and a second majestic started then -- even for -v -- stopped the starting
# daemon in two tries of three on a gk7205v300, leaving the camera without
# video after every crash. The WebUI sends the version when it sends the crash.
write_meta() {
	soc=$(ipcinfo --chip-name 2>/dev/null)
	[ "$(ipcinfo -v 2>/dev/null)" = sigmastar ] && soc=$(fw_printenv -n soc 2>/dev/null)
	{
		printf '{\n'
		printf '  "harvested": %s,\n' "$(jstr "$(date -u '+%Y-%m-%d %H:%M:%S' 2>/dev/null)")"
		printf '  "firmware": {"version": %s, "variant": %s, "build": %s, "build_id": %s, "platform": %s},\n' \
			"$(jstr "$(os_value OPENIPC_VERSION)")" "$(jstr "$(os_value BUILD_OPTION)")" \
			"$(jstr "$(os_value GITHUB_VERSION)")" "$(jstr "$(os_value BUILD_ID)")" \
			"$(jstr "$(os_value BUILD_PLATFORM)")"
		printf '  "kernel": {"release": %s, "version": %s},\n' "$(jstr "$(uname -r)")" "$(jstr "$(uname -v)")"
		printf '  "cmdline": %s,\n' "$(jstr "$(cat /proc/cmdline 2>/dev/null)")"
		printf '  "soc": %s,\n' "$(jstr "$soc")"
		printf '  "sensor": %s,\n' "$(jstr "$(fw_printenv -n sensor 2>/dev/null)")"
		printf '  "config": %s\n' "$(config_lines)"
		printf '}\n'
	} > "$1"
}

# Move the crash the owner has not dealt with out of the way of this one, and
# drop the oldest beyond KEEP. Named by the order the crashes came in -- a
# sequence kept beside them, not the clock, which a camera without an RTC
# can repeat after a reboot -- and then by when it was captured, for a reader.
keep_previous() {
	[ -s "$CRASH/crash.tar.gz" ] || return 0
	mkdir -p "$CRASH/older" 2>/dev/null || return 1
	seq=$(cat "$CRASH/older/.seq" 2>/dev/null | tr -cd '0-9')
	seq=$(( ${seq:-0} + 1 ))
	echo "$seq" > "$CRASH/older/.seq" 2>/dev/null || return 1
	when=$(sed -n 's/^utc=//p' "$CRASH/pending" 2>/dev/null | tr -cd '0-9')
	name=$(printf '%06d-%s' "$seq" "${when:-0}")
	[ -e "$CRASH/older/$name.tar.gz" ] && return 1
	mv "$CRASH/crash.tar.gz" "$CRASH/older/$name.tar.gz" 2>/dev/null || return 1
	n=$(ls -1 "$CRASH/older"/*.tar.gz 2>/dev/null | wc -l)
	for f in $(ls -1 "$CRASH/older"/*.tar.gz 2>/dev/null | sort); do
		[ "$n" -le "$KEEP" ] && break
		rm -f "$f"
		n=$((n - 1))
	done
	return 0
}

# busybox tar has no built-in -z, and piping tar into gzip would hide tar's exit
# status behind gzip's -- a partial read could then produce a nonempty archive
# that looks like success. So stage the records and meta.json in a directory,
# tar it to a file and check tar itself, then gzip, then the publish: the pstore
# records are deleted ONLY once the finished bundle is safely in place. A failed
# capture must never erase the evidence it exists to keep (#2396 review).
stage=$CRASH/stage
rm -rf "$stage" "$CRASH/crash.tar.tmp" "$CRASH/crash.tar.tmp.gz" 2>/dev/null
if mkdir "$stage" 2>/dev/null &&
	cp "$PSTORE"/dmesg-* "$stage"/ 2>/dev/null &&
	{ write_meta "$stage/meta.json" 2>/dev/null || rm -f "$stage/meta.json"; true; } &&
	tar cf "$CRASH/crash.tar.tmp" -C "$stage" . 2>/dev/null &&
	gzip -f "$CRASH/crash.tar.tmp" 2>/dev/null &&
	[ -s "$CRASH/crash.tar.tmp.gz" ] &&
	keep_previous &&
	mv "$CRASH/crash.tar.tmp.gz" "$CRASH/crash.tar.gz" 2>/dev/null; then
	{
		echo "utc=$(date -u '+%Y-%m-%d %H:%M:%S' 2>/dev/null)"
		echo "records=$(ls -1 "$PSTORE"/dmesg-* 2>/dev/null | wc -l)"
		echo "bytes=$(wc -c < "$CRASH/crash.tar.gz" 2>/dev/null)"
		echo "older=$(ls -1 "$CRASH/older"/*.tar.gz 2>/dev/null | wc -l)"
	} > "$CRASH/pending" 2>/dev/null
	logger -s -t crashlog "preserved pstore crash log to $CRASH/crash.tar.gz" 2>/dev/null
	rm -f "$PSTORE"/dmesg-* 2>/dev/null
else
	logger -s -t crashlog "could not preserve the pstore crash log; leaving records in place" 2>/dev/null
	rm -f "$CRASH/crash.tar.tmp" "$CRASH/crash.tar.tmp.gz" 2>/dev/null
fi
rm -rf "$stage" 2>/dev/null
exit 0
