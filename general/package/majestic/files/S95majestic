#!/bin/sh

# rcS exports TZ once at boot, so a later edit to /etc/TZ is shadowed by the
# stale value inherited through majestic's own children (web UI, sysupgrade).
# Re-read it here so a restart picks up the new zone without a reboot.
# musl never reads /etc/TZ itself; it uses $TZ, else /etc/localtime.
[ -r /etc/TZ ] && export TZ=$(cat /etc/TZ)

DAEMON="majestic"
DAEMON_PATH="/usr/bin/$DAEMON"
DAEMON_ARGS="-s"

# majestic is run by a small supervisor (this script, `supervise`), which
# starts it again when it dies of a fault -- before, a crash left the camera
# without video until someone restarted it by hand. It waits longer after each
# crash, and after five in ten minutes it stops trying and leaves
# /etc/crash/majestic.loop, which the web interface reports: a majestic that
# dies at every start would otherwise hold the camera in a restart loop. The
# dump majestic writes as it dies stays in /etc/crash for the crash report.
SUPERVISOR=/var/run/majestic-supervise.pid
CRASH=/etc/crash
UPGRADE_LOCK=/tmp/sysupgrade.lock
BACKOFF="5 30 120"
WINDOW=600
LIMIT=5

# Find the daemon by executable, never through a pidfile. Given -p, busybox
# start-stop-daemon inspects only the pid that file holds and never scans
# /proc, so the moment that pid is stale it can no longer see the live daemon:
# -S starts a SECOND majestic, which dies on the busy sensor HAL and leaves its
# own dead pid behind in the file, and -K without -x signals whatever unrelated
# process has since reused the pid. -x scans every process instead, and -a
# keeps argv[0] as "majestic" so ps output and name-based tools are unchanged.
running() {
	start-stop-daemon -t -K -q -x "$DAEMON_PATH"
}

# Started with SIGHUP ignored, because the disposition survives exec() and a
# handler does not. majestic's reload signal is SIGHUP, and until it reaches
# init_libevent() the default action applies -- which is to terminate. That gap
# is reachable: -b returns at the fork, so boot carries straight on into the S98
# scripts, and wifibroadcast writes fourteen keys and then signals. Anyone
# following the wiki's `killall -HUP majestic` by hand can land in it too.
#
# It has to be done here rather than inside majestic. The gap that gets hit is
# not between main() and init_libevent() -- that is sub-millisecond -- it is
# before main() runs at all, while the dynamic loader maps the vendor
# libraries: `killall` already matches the name exec() set, and not one
# instruction of the program has run. No code in the daemon can cover that, but
# an ignore inherited across exec() covers all of it, and libevent replaces the
# disposition when it installs the real handler.
#
# Measured on a hi3516ev200, 25 `killall -1` fired into the start window:
# without this the daemon is dead every run; with it, it survives every run.
start() {
	echo -n "Starting $DAEMON: "
	lock
	if running || supervising; then
		unlock
		echo "OK (already running)"
		return 0
	fi
	if [ ! -x "$DAEMON_PATH" ]; then
		unlock
		echo "FAIL"
		return 1
	fi
	# A start, by hand or at boot, is a fresh run: the note that the last one
	# was given up on is about a majestic that is no longer there.
	rm -f "$CRASH/majestic.loop"
	(
		trap '' HUP
		exec sh "$0" supervise
	) </dev/null >/dev/null 2>&1 &
	echo $! > "$SUPERVISOR"
	# Returned only once the supervisor is the process the pid names, so a
	# stop that follows at once finds it.
	i=0
	while ! supervising && [ $i -lt 50 ]; do
		i=$((i + 1))
		sleep 0.1
	done
	unlock
	echo "OK"
}

# start and stop one at a time: two starts at once would leave a supervisor
# no pid names, which a stop could then not end. The lock holds its holder's
# pid, and is taken over only once that process is gone -- a start that was
# killed -- never from one still running.
lock() {
	until mkdir "$SUPERVISOR.lock" 2>/dev/null; do
		holder=$(cat "$SUPERVISOR.lock/pid" 2>/dev/null)
		if [ -n "$holder" ] && ! kill -0 "$holder" 2>/dev/null; then
			rm -rf "$SUPERVISOR.lock"
			continue
		fi
		sleep 1
	done
	echo $$ > "$SUPERVISOR.lock/pid"
}
unlock() {
	rm -rf "$SUPERVISOR.lock"
}

# The supervisor's pid, if it is the supervisor still: a pid in a file can
# have been reused by anything since.
supervising() {
	pid=$(cat "$SUPERVISOR" 2>/dev/null)
	[ -n "$pid" ] || return 1
	# This script, run as `supervise`: its last two arguments.
	set -- $(tr '\0' ' ' < "/proc/$pid/cmdline" 2>/dev/null)
	[ $# -ge 2 ] || return 1
	eval "script=\${$(($# - 1))} last=\${$#}"
	[ "$last" = supervise ] && [ "${script##*/}" = "${0##*/}" ]
}

# The signals a fault ends majestic with: SIGILL, SIGABRT, SIGBUS (7, and 10
# on MIPS), SIGFPE, SIGSEGV -- and SIGKILL, which is how the kernel's
# out-of-memory killer ends it. SIGTERM and SIGINT are someone stopping it,
# and an exit of its own is its own decision: neither is restarted.
crashed() {
	case "$1" in
		4 | 6 | 7 | 8 | 9 | 10 | 11) return 0 ;;
	esac
	return 1
}

supervise() {
	trap '' HUP
	# A stop while it waits ends the wait, not just the run after it.
	trap 'kill $waiting 2>/dev/null; rm -f "$SUPERVISOR"; exit 0' TERM INT
	echo $$ > "$SUPERVISOR"
	waiting=
	crashes=
	while :; do
		# An upgrade has the camera: it brings majestic back itself. Asked
		# before every start, the first and each one after a wait.
		[ -f "$UPGRADE_LOCK" ] && break
		start-stop-daemon -S -q -x "$DAEMON_PATH" -a "$DAEMON" -- $DAEMON_ARGS
		rc=$?
		[ "$rc" -gt 128 ] && crashed $((rc - 128)) || break
		sig=$((rc - 128))
		[ -f "$UPGRADE_LOCK" ] && break
		now=$(cut -d. -f1 /proc/uptime)
		recent=
		n=0
		for t in $crashes $now; do
			if [ $((now - t)) -lt "$WINDOW" ]; then
				recent="$recent $t"
				n=$((n + 1))
			fi
		done
		crashes=$recent
		if [ "$n" -ge "$LIMIT" ]; then
			mkdir -p "$CRASH"
			printf 'utc=%s\ncrashes=%s\nsignal=%s\n' "$(date -u '+%Y-%m-%d %H:%M:%S')" "$n" "$sig" > "$CRASH/majestic.loop"
			logger -t "$DAEMON" "crashed $n times in $((WINDOW / 60)) minutes (signal $sig); not starting it again" 2>/dev/null
			break
		fi
		delay=$(echo $BACKOFF | cut -d' ' -f"$n")
		[ -n "$delay" ] || delay=${BACKOFF##* }
		logger -t "$DAEMON" "crashed (signal $sig); starting it again in ${delay}s" 2>/dev/null
		sleep "$delay" &
		waiting=$!
		wait "$waiting"
		waiting=
	done
	rm -f "$SUPERVISOR"
}

stop() {
	echo -n "Stopping $DAEMON: "
	lock
	# The supervisor first, so it does not start what is being stopped.
	supervising && kill "$pid" 2>/dev/null
	start-stop-daemon -K -q -x "$DAEMON_PATH"
	i=0
	while running && [ $i -lt 10 ]; do
		i=$((i + 1))
		sleep 1
	done
	if running; then
		unlock
		echo "FAIL"
		return 1
	fi
	rm -f "/var/run/$DAEMON.pid" "$SUPERVISOR"
	unlock
	echo "OK"
}

case "$1" in
	start|stop)
		$1
		;;

	supervise)
		supervise
		;;

	restart)
		stop || exit 1
		sleep 3
		start
		;;

	reload)
		start-stop-daemon -K -s 1 -q -x "$DAEMON_PATH"
		;;

	*)
		echo "Usage: $0 {start|stop|restart|reload}"
		exit 1
		;;
esac
