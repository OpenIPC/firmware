config BR2_PACKAGE_MAJESTIC
	bool "Majestic streamer"
	# majestic links these at run time, so it cannot rely on another package
	# happening to pull them in. json-c is in majestic.mk's dependencies too,
	# which builds it but says nothing to Kconfig; libyaml came only through
	# yaml-cli.
	select BR2_PACKAGE_JSON_C
	select BR2_PACKAGE_LIBYAML
	select BR2_PACKAGE_ZLIB
	help
	  Tiny but powerful IPC streaming software
	  (non-commercial version for personal use only)
	  https://openipc.org
