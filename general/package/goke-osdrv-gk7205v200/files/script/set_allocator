#!/bin/sh


get_env() {
  bootargs=$(fw_printenv -n bootargs)
  # Everything already on the command line except the three arguments this
  # script decides, in the order it was in. The script used to rebuild
  # bootargs from a fixed list of keys instead, and silently dropped whatever
  # was not on it -- ubi.mtd among them, so the next boot of a NAND/UBI board
  # could not attach ubi0 and panicked mounting its root (#2281).
  # Keys the extras variable sets are left to it, so a second run does not
  # carry two copies.
  extras=$(fw_printenv -n extras)
  kept=$(echo ${bootargs} | awk -v extras="${extras}" 'BEGIN { RS = " "; n = split(extras, e, " "); for (i = 1; i <= n; i++) { k = e[i]; sub(/=.*/, "", k); skip[k] = 1 } skip["mem"] = skip["mmz"] = skip["mmz_allocator"] = skip["osmem"] = 1 } { sub(/\n$/, ""); k = $0; sub(/=.*/, "", k); if ($0 != "" && !(k in skip)) printf "%s ", $0 }')
  osmem=$(fw_printenv -n osmem)
  totalmem=$(fw_printenv -n totalmem)
}

calc_mmz() {
  mem_start=0x40000000
  mem_total=$(fw_printenv -n totalmem | tr -d 'M')
  mem_total=${mem_total:=64}
  os_mem_size=$(fw_printenv -n osmem | tr -d 'M')
  os_mem_size=${os_mem_size:=32}
  mmz_start=$(echo "$mem_start $os_mem_size" | awk 'BEGIN { temp = 0; } { temp = $1/1024/1024 + $2; } END { printf("0x%x00000\n", temp); }')
  mmz_size=$(echo "$mem_total $os_mem_size" | awk 'BEGIN { temp = 0; } { temp = $1 - $2; } END { printf("%dM\n", temp); }')
  mmz=anonymous,0,$mmz_start,$mmz_size
}


# A kernel with goke_mem measures DRAM and picks the allocator and the OS share
# itself, at every boot, under any bootloader; nothing has to be written for a
# camera to come up right. Here the user overrides it: mmz_allocator= and
# osmem= go on the command line, which that kernel reads, and mem= stays the
# OS share for a kernel without it. `auto` drops the override.
if [ -d /sys/module/goke_mem/parameters ] && [ -n "$(cat /sys/module/goke_mem/parameters/allocator 2>/dev/null)" ]; then
  p=/sys/module/goke_mem/parameters
  case "$1" in
  gk|cma|auto)
    get_env
    os=${2:-${osmem:-32M}}
    if [ "$1" = auto ]; then
      newbootargs="mem=${os} ${kept}${extras}"
    else
      newbootargs="mem=${os} ${kept}mmz_allocator=$1 osmem=${os} ${extras}"
    fi
    if ! fw_setenv bootargs ${newbootargs}; then
      echo "Could not write bootargs; nothing changes at the next boot."
      exit 1
    fi
    echo ${newbootargs}
    echo "Applies at the next boot. Now: DRAM $(cat $p/dram)M, OS $(cat $p/osmem)M, $(cat $p/allocator), mmz=$(cat $p/mmz)"
    exit 0
    ;;
  mmz)
    cat $p/mmz
    exit 0
    ;;
  *)
    echo "Usage: set_allocator gk|cma [osmem] | auto | mmz"
    echo "Now: DRAM $(cat $p/dram)M, OS $(cat $p/osmem)M, $(cat $p/allocator), mmz=$(cat $p/mmz)"
    exit 1
    ;;
  esac
fi

# The zone `cma` would write, without writing it. The load script compares it
# with the zone the kernel booted with: bootargs are written once, so an osmem
# or totalmem changed afterwards never reached them on their own.
if [ "$1" = 'mmz' ]; then
  get_env
  calc_mmz
  echo "${mmz}"
  exit 0
fi

if [[ "$1" == 'gk' ]]; then
  echo "Allocator selected as gk..."
  get_env
  mem=${osmem:=32M}
  newbootargs="mem=${mem} ${kept}mmz_allocator=gk ${extras}"
  echo ${newbootargs}
  fw_setenv bootargs ${newbootargs}
  #
elif [[ "$1" == 'cma'  ]]; then
  echo "Allocator selected as cma..."
  get_env
  calc_mmz
  mem=${totalmem:=64M}
  newbootargs="mem=${mem} ${kept}mmz_allocator=cma mmz=${mmz} ${extras}"
  fw_setenv bootargs ${newbootargs}
  echo ${newbootargs}
else
  echo "NO or WRONG allocator, please select gk or cma."
  exit 1
fi
