config BR2_PACKAGE_XIONGMAI_OPENSDK_XM510
	bool "xiongmai-opensdk-xm510"
	depends on BR2_LINUX_KERNEL
	help
	  Library for running uclibc applications in musl environment,
	  the open MMZ (open_mmz), H.264 encoder (open_h264), video input
	  (open_vi), ISP (open_isp) and region (open_rgn) kernel modules,
	  and xmispd, the open ISP daemon, from OpenIPC/openxiongmai.
	  xmispd takes the vendor isp daemon's place after
	  "fw_setenv xmispd 1" and a reboot, for the sensors it has.

	  https://github.com/OpenIPC/openxiongmai
