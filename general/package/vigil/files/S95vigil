#!/bin/sh

# The control of this daemon is S95majestic's, kept the same on purpose:
# one supervisor that restarts it after a crash with a growing wait, gives up
# after a crash loop and leaves a note in /etc/crash, and stays out of the way
# of an upgrade. What differs is marked "vigil:".

# rcS exports TZ once at boot, so a later edit to /etc/TZ is shadowed by the
# stale value inherited from it. Re-read it here so a restart picks up the new
# zone (the clock in the UI, recording file names) without a reboot.
[ -r /etc/TZ ] && export TZ=$(cat /etc/TZ)

DAEMON="vigild"
DAEMON_PATH="/usr/bin/$DAEMON"
# vigil: vigild keeps its configuration in this file itself -- cameras,
# recording, its HTTP API -- and saves what the API changes into it, applying
# it while it runs. Options on its command line would override the file and be
# saved by the API's next change, so it is given none of its settings, only -f;
# -s sends vigild's log, and the SDK's, to syslog.
CONFIG=/etc/vigil.json
# vigil: what this script read the settings from before vigild kept its own;
# converted once into $CONFIG (migrate).
LEGACY=/etc/vigil.yaml
# vigil: the image's own files, under the writable root (init mounts the
# squashfs here).
ROM=/rom
# vigil: the recording directory asked for, while recording is held off
# (vigil_config).
HELD=/etc/vigil.rec-held

# vigild is run by a small supervisor (this script, `supervise`), which starts
# it again when it dies of a fault: an NVR that crashed would otherwise show
# nothing and record nothing until someone restarted it by hand. It waits
# longer after each crash, and after five in ten minutes it stops trying and
# leaves /etc/crash/vigil.loop: a vigild that dies at every start would
# otherwise hold the board in a restart loop.
SUPERVISOR=/var/run/vigil-supervise.pid
CRASH=/etc/crash
UPGRADE_LOCK=/tmp/sysupgrade.lock
BACKOFF="5 30 120"
WINDOW=600
LIMIT=5
# vigil: how often, while vigild runs, the recording directory is looked at
# again: for a card or disk mounted later, or one that has gone (rec_watch).
CARD_POLL=10

# Find the daemon by executable, never through a pidfile. Given -p, busybox
# start-stop-daemon inspects only the pid that file holds and never scans
# /proc, so the moment that pid is stale it can no longer see the live daemon:
# -S would start a SECOND vigild, which fails on the busy video layer, and -K
# without -x signals whatever unrelated process has since reused the pid. -x
# scans every process instead.
running() {
	start-stop-daemon -t -K -q -x "$DAEMON_PATH"
}

# Started with SIGHUP ignored, because the disposition survives exec(): a
# stray `killall -HUP` (meant for majestic-style reloads) would otherwise
# terminate vigild, which has no use for the signal.
start() {
	echo -n "Starting $DAEMON: "
	lock
	if running || supervising; then
		unlock
		echo "OK (already running)"
		return 0
	fi
	if [ ! -x "$DAEMON_PATH" ]; then
		unlock
		echo "FAIL"
		return 1
	fi
	# A start, by hand or at boot, is a fresh run: the note that the last one
	# was given up on is about a vigild that is no longer there.
	rm -f "$CRASH/vigil.loop"
	migrate
	(
		trap '' HUP
		exec sh "$0" supervise
	) </dev/null >/dev/null 2>&1 &
	echo $! > "$SUPERVISOR"
	# Returned only once the supervisor is the process the pid names, so a
	# stop that follows at once finds it.
	i=0
	while ! supervising && [ $i -lt 50 ]; do
		i=$((i + 1))
		sleep 0.1
	done
	unlock
	echo "OK"
}

# start and stop one at a time: two starts at once would leave a supervisor
# no pid names, which a stop could then not end. The lock holds its holder's
# pid, and is taken over only once that process is gone -- a start that was
# killed -- never from one still running. vigil: a holder writes its pid the
# moment after its mkdir, so a lock still without one after five seconds was
# left by a command killed in between, and is taken over too; otherwise every
# later start and stop would wait on it forever.
lock() {
	nopid=0
	until mkdir "$SUPERVISOR.lock" 2>/dev/null; do
		holder=$(cat "$SUPERVISOR.lock/pid" 2>/dev/null)
		# Removed only if it still names what was judged stale: another
		# command reclaiming the same lock may have taken it in between.
		if [ -n "$holder" ]; then
			nopid=0
			if ! kill -0 "$holder" 2>/dev/null; then
				[ "$(cat "$SUPERVISOR.lock/pid" 2>/dev/null)" = "$holder" ] &&
					rm -rf "$SUPERVISOR.lock"
				continue
			fi
		else
			nopid=$((nopid + 1))
			if [ "$nopid" -ge 5 ]; then
				[ -z "$(cat "$SUPERVISOR.lock/pid" 2>/dev/null)" ] &&
					rm -rf "$SUPERVISOR.lock"
				nopid=0
				continue
			fi
		fi
		sleep 1
	done
	echo $$ > "$SUPERVISOR.lock/pid"
}
unlock() {
	rm -rf "$SUPERVISOR.lock"
}

# The supervisor's pid, if it is the supervisor still: a pid in a file can
# have been reused by anything since.
supervising() {
	pid=$(cat "$SUPERVISOR" 2>/dev/null)
	[ -n "$pid" ] || return 1
	# This script, run as `supervise`: its last two arguments.
	set -- $(tr '\0' ' ' < "/proc/$pid/cmdline" 2>/dev/null)
	[ $# -ge 2 ] || return 1
	eval "script=\${$(($# - 1))} last=\${$#}"
	[ "$last" = supervise ] && [ "${script##*/}" = "${0##*/}" ]
}

# The signals a fault ends vigild with: SIGILL, SIGABRT, SIGBUS (7, and 10
# on MIPS), SIGFPE, SIGSEGV -- and SIGKILL, which is how the kernel's
# out-of-memory killer ends it. SIGTERM and SIGINT are someone stopping it,
# and an exit of its own is its own decision (e.g. no MPP modules): neither is
# restarted.
crashed() {
	case "$1" in
		4 | 6 | 7 | 8 | 9 | 10 | 11) return 0 ;;
	esac
	return 1
}

# vigil: the mount that holds $1 must be a disk, a card or a network share --
# a filesystem from the list below. RAM (tmpfs, ramfs) would eat the memory the
# decoders and the system need, the flash root (squashfs, overlay, jffs2,
# ubifs) would wear out and fill, and virtual ones (proc, sysfs, devtmpfs)
# hold nothing; and it must be mounted read-write. The longest mount point
# that is a prefix wins.
recordable() {
	# /proc/mounts escapes space, tab, newline and backslash in a mount point
	# as \040, \011, \012 and \134; decoded before the comparison, or a disk
	# mounted at "/mnt/Disk One" could never be recorded to.
	# The path goes in through the environment: awk -v would interpret the
	# backslashes in it as escapes.
	VIGIL_REC="$1" awk '
		BEGIN { p = ENVIRON["VIGIL_REC"] }
		{ m = $2
		  gsub(/\\040/, " ", m); gsub(/\\011/, "\t", m); gsub(/\\012/, "\n", m)
		  gsub(/\\134/, "\\", m)
		  if (p == m || index(p, m == "/" ? "/" : m "/") == 1)
			if (length(m) > length(best)) { best = m; fs = $3; opts = "," $4 "," } }
		END { exit !(best != "" && best != "/" && opts !~ /,ro,/ &&
			fs ~ /^(vfat|msdos|exfat|ext[234]|f2fs|xfs|btrfs|ntfs|ntfs3|fuseblk|nfs|nfs4|cifs|smb3)$/) }
	' /proc/mounts
}

# vigil: where a recording into $1 would land. vigild creates the directory
# itself, so it need not exist yet: the deepest part of it that does is
# resolved -- a link from a card to /tmp is judged by where it lands -- and the
# rest is kept as written.
landing() {
	p=$1 rest=
	while :; do
		case "$p" in
			?*/) p=${p%/} ;;
			*) break ;;
		esac
	done
	while [ -n "$p" ] && [ ! -e "$p" ]; do
		rest="/${p##*/}$rest"
		case "$p" in
			*/*) p=${p%/*} ;;
			*) p= ;;
		esac
	done
	p=$(readlink -f "${p:-/}" 2>/dev/null)
	[ "$p" = / ] && p=
	echo "$p$rest"
}

# vigil: whether the recording $CONFIG asks for may go ahead, asked before
# every start and every CARD_POLL seconds while vigild runs (rec_watch).
# vigild creates and records into whatever directory it is given: with the
# card or disk not mounted (yet, or any more) it would create the path in the
# flash root beneath the mount point and record there, and a path on /tmp
# would fill RAM. Then vigild runs with recording held off (-o none) until
# the disk is there.
#
# What the API shows, and saves at its next change, is the configuration in
# force, so an unrelated change made while recording is held off saves
# record.path as empty. The path asked for is therefore kept in $HELD until
# vigild records into it again, and an empty record.path does not replace it
# meanwhile: once the disk is there, vigild is started with -o and that path,
# which the API's next change saves back. Sets rec_off (hold it off) or
# rec_set (the path to pass), or neither (the file as it is).
vigil_config() {
	rec_off= rec_set=
	# yaml-cli reads JSON (it is YAML), and exits 1 for a key that is absent
	# and for a file it cannot open or parse alike; only the second says
	# anything. vigild reports a file it cannot load itself.
	file_path=$(yaml-cli -i "$CONFIG" -g .record.path 2>"$SUPERVISOR.err")
	rec_path=$file_path
	if [ "$1" != quiet ] && [ -s "$SUPERVISOR.err" ]; then
		logger -t vigil "cannot check the recording directory in $CONFIG ($(head -1 "$SUPERVISOR.err"))" 2>/dev/null
	fi
	rm -f "$SUPERVISOR.err"
	held=$(cat "$HELD" 2>/dev/null)
	if [ -n "$rec_path" ]; then
		# The owner's own choice: what was held is history.
		if [ -n "$held" ] && [ "$held" != "$rec_path" ]; then
			rm -f "$HELD"
			held=
		fi
	elif [ -n "$held" ]; then
		rec_path=$held
	else
		return 0
	fi
	# A relative path is refused by vigild with the rest of the file.
	case "$rec_path" in
		/*) ;;
		*) return 0 ;;
	esac
	# "." and ".." are not followed: the part of the path vigild would
	# create cannot be judged by its text once it climbs out of a mount.
	case "$rec_path/" in
		*/./* | */../*) ;;
		*)
			if recordable "$(landing "$rec_path")"; then
				# vigild gets the path from the file, or from -o when
				# an API change saved it as empty meanwhile.
				if [ -n "$held" ]; then
					if [ -z "$file_path" ]; then
						rec_set=$held
					else
						rm -f "$HELD"
					fi
				fi
				return 0
			fi ;;
	esac
	rec_off=1
	[ "$held" = "$rec_path" ] || printf '%s\n' "$rec_path" > "$HELD"
	[ "$1" != quiet ] &&
		logger -t vigil "not recording for now: $rec_path is not on a disk or card; looking for it every ${CARD_POLL}s" 2>/dev/null
}

# vigil: while vigild runs, look at the recording every CARD_POLL seconds: a
# card or disk mounted after boot (the automounter knows nothing of vigil)
# would otherwise go unused until someone restarted it, and one that goes away,
# or a path the API sets that is not on a disk, would have vigild record onto
# the flash. When the answer changes, vigild is ended and the supervisor,
# seeing the note, starts it again with the new answer. $1 is how it runs now
# (off: held off, on: recording, or nothing to record); $2 the path it was
# given with -o, if any.
rec_watch() {
	trap 'exit 0' TERM
	sum=$(cksum "$CONFIG" 2>/dev/null)
	while sleep "$CARD_POLL"; do
		# Started with -o and a held path, vigild saves that path with any
		# change made through the API; whatever the file says after a
		# save is the owner's, an empty path included.
		if [ -n "$2" ] && [ "$(cksum "$CONFIG" 2>/dev/null)" != "$sum" ]; then
			rm -f "$HELD"
			set -- "$1"
		fi
		vigil_config quiet
		now=on
		[ -n "$rec_off" ] && now=off
		[ "$now" = "$1" ] && continue
		: > "$SUPERVISOR.card"
		if [ "$now" = on ]; then
			logger -t vigil "$rec_path is on a disk now; starting vigild again to record into it" 2>/dev/null
		else
			logger -t vigil "$rec_path is not on a disk or card now; starting vigild again with recording held off" 2>/dev/null
		fi
		start-stop-daemon -K -q -x "$DAEMON_PATH"
		return 0
	done
}

# vigil: JSON string contents for $1: backslash, quote and control
# characters escaped. Through the environment: awk -v would interpret the
# backslashes in it as escapes.
json_str() {
	VIGIL_S="$1" awk 'BEGIN {
		for (i = 1; i < 32; i++) ctl = ctl sprintf("%c", i)
		s = ENVIRON["VIGIL_S"]
		for (i = 1; i <= length(s); i++) {
			c = substr(s, i, 1)
			if (c == "\\" || c == "\"") o = o "\\" c
			else if ((k = index(ctl, c)) > 0) o = o sprintf("\\u%04x", k)
			else o = o c
		}
		printf "%s", o
	}'
}

# vigil: $LEGACY's $1 as an integer in $2..$3, as vigild's schema has it (a
# value out of range would make vigild refuse the whole file); nothing when
# it is not set or not a number, for vigild's default.
legacy_int() {
	v=$(yaml-cli -i "$LEGACY" -g ".record.$1" 2>/dev/null)
	case "$v" in
		'') return 0 ;;
		*[!0-9]*)
			logger -t vigil "$LEGACY: record.$1 '$v' is not a number; not converted, vigild's default applies" 2>/dev/null
			return 0 ;;
	esac
	v=${v#"${v%%[!0]*}"}
	[ -n "$v" ] || v=0
	if [ ${#v} -gt 6 ] || [ "$v" -gt "$3" ]; then
		v=$3
	elif [ "$v" -lt "$2" ]; then
		v=$2
	fi
	echo "$v"
}

# vigil: a board upgraded from a vigil that had no configuration of its own
# may carry the $LEGACY its owner edited (in the overlay: the image ships
# $CONFIG instead). It is converted once into $CONFIG -- the cameras and the
# recording, all it held -- and kept as $LEGACY.migrated. Only over the
# $CONFIG the image ships (or none): one that differs from it was written
# since, through the API or by hand, and is the newer of the two.
migrate() {
	[ -f "$LEGACY" ] || return 0
	if [ -e "$CONFIG" ] && ! cmp -s "$CONFIG" "$ROM$CONFIG"; then
		logger -t vigil "$LEGACY is not converted: $CONFIG has been changed since, and is used" 2>/dev/null
		return 0
	fi
	cams=$(yaml-cli -i "$LEGACY" -g .cameras 2>"$SUPERVISOR.err")
	if [ -s "$SUPERVISOR.err" ]; then
		logger -t vigil "$LEGACY is not converted: $(head -1 "$SUPERVISOR.err")" 2>/dev/null
		rm -f "$SUPERVISOR.err"
		return 0
	fi
	rm -f "$SUPERVISOR.err"
	path=$(yaml-cli -i "$LEGACY" -g .record.path 2>/dev/null)
	case "$path" in
		'' | /*) ;;
		*)
			logger -t vigil "$LEGACY: record.path '$path' is not an absolute path; not converted" 2>/dev/null
			path= ;;
	esac
	if [ ${#path} -gt 191 ]; then
		logger -t vigil "$LEGACY: record.path is longer than vigild takes; not converted" 2>/dev/null
		path=
	fi
	seg=$(legacy_int segment 10 3600)
	keep=$(legacy_int keep 0 64)
	# The URLs were word-split, as when they were passed as options. One
	# vigild would refuse would make it refuse the whole file, so what is
	# plainly not a camera URL is left out (named by its place: URLs hold
	# passwords, and the log is not the place for them).
	list= n=0 i=0
	set -f
	for url in $cams; do
		i=$((i + 1))
		case "$url" in
			rtsp://?* | netip://?* | capture:[0-9]*) ;;
			*)
				logger -t vigil "$LEGACY: camera $i is not a camera URL; not converted" 2>/dev/null
				continue ;;
		esac
		if [ ${#url} -gt 511 ] || [ $n -ge 16 ]; then
			logger -t vigil "$LEGACY: camera $i is too long, or one too many; not converted" 2>/dev/null
			continue
		fi
		list="$list${list:+,}$(printf '\n\t\t{ "url": "%s" }' "$(json_str "$url")")"
		n=$((n + 1))
	done
	set +f
	[ -n "$list" ] && list="$list$(printf '\n\t')"
	rec=$(printf '\n\t\t"path": "%s"' "$(json_str "$path")")
	[ -n "$seg" ] && rec="$rec$(printf ',\n\t\t"segment": %s' "$seg")"
	[ -n "$keep" ] && rec="$rec$(printf ',\n\t\t"keep": %s' "$keep")"
	# 0600 from the start: it holds the cameras' passwords.
	if ! (
		umask 077
		printf '{\n\t"version": 1,\n\t"cameras": [%s],\n\t"record": {%s\n\t}\n}\n' \
			"$list" "$rec" > "$CONFIG.migrate"
	); then
		rm -f "$CONFIG.migrate"
		logger -t vigil "$LEGACY is not converted: cannot write $CONFIG" 2>/dev/null
		return 0
	fi
	# The new file in place first: interrupted before the old one is moved
	# aside, the next start finds $CONFIG changed and leaves both be.
	if ! mv -f "$CONFIG.migrate" "$CONFIG"; then
		rm -f "$CONFIG.migrate"
		logger -t vigil "$LEGACY is not converted: cannot write $CONFIG" 2>/dev/null
		return 0
	fi
	mv -f "$LEGACY" "$LEGACY.migrated" && chmod 600 "$LEGACY.migrated"
	sync
	logger -t vigil "converted $LEGACY into $CONFIG: $n camera(s), recording ${path:-off}; the old file is kept as $LEGACY.migrated" 2>/dev/null
}

supervise() {
	trap '' HUP
	# A stop while it waits ends the wait, not just the run after it.
	# The pidfile goes only while it still names this supervisor: by then a
	# new start may have written its own.
	trap 'kill $waiting $watcher 2>/dev/null; rm -f "$SUPERVISOR.card"; release; exit 0' TERM INT
	echo $$ > "$SUPERVISOR"
	waiting=
	watcher=
	crashes=
	rm -f "$SUPERVISOR.card"
	while :; do
		# An upgrade has the board: it reboots it when done. Asked
		# before every start, the first and each one after a wait.
		[ -f "$UPGRADE_LOCK" ] && break
		vigil_config
		set -- -s -f "$CONFIG"
		mode=on
		if [ -n "$rec_off" ]; then
			set -- "$@" -o none
			mode=off
		elif [ -n "$rec_set" ]; then
			set -- "$@" -o "$rec_set"
			logger -t vigil "record.path was saved empty while recording was held off; recording into $rec_set as asked before" 2>/dev/null
		fi
		# Its own process, so it is not taken for a second supervisor.
		sh "$0" watch "$mode" "$rec_set" </dev/null >/dev/null 2>&1 &
		watcher=$!
		start-stop-daemon -S -q -x "$DAEMON_PATH" -a "$DAEMON" -- "$@"
		rc=$?
		[ -n "$watcher" ] && kill "$watcher" 2>/dev/null
		watcher=
		# vigil: ended by rec_watch because whether it may record has
		# changed -- a fresh start, not a crash and not a stop.
		if [ -f "$SUPERVISOR.card" ]; then
			rm -f "$SUPERVISOR.card"
			continue
		fi
		if ! { [ "$rc" -gt 128 ] && crashed $((rc - 128)); }; then
			# vigil: an exit of its own is not restarted, but is said: an NVR
			# with a blank screen should leave a reason in the log.
			[ "$rc" -ne 0 ] && [ "$rc" -le 128 ] &&
				logger -t vigil "vigild exited with status $rc; not starting it again" 2>/dev/null
			break
		fi
		sig=$((rc - 128))
		[ -f "$UPGRADE_LOCK" ] && break
		now=$(cut -d. -f1 /proc/uptime)
		recent=
		n=0
		for t in $crashes $now; do
			if [ $((now - t)) -lt "$WINDOW" ]; then
				recent="$recent $t"
				n=$((n + 1))
			fi
		done
		crashes=$recent
		if [ "$n" -ge "$LIMIT" ]; then
			mkdir -p "$CRASH"
			printf 'utc=%s\ncrashes=%s\nsignal=%s\n' "$(date -u '+%Y-%m-%d %H:%M:%S')" "$n" "$sig" > "$CRASH/vigil.loop"
			logger -t vigil "crashed $n times in $((WINDOW / 60)) minutes (signal $sig); not starting it again" 2>/dev/null
			break
		fi
		delay=$(echo $BACKOFF | cut -d' ' -f"$n")
		[ -n "$delay" ] || delay=${BACKOFF##* }
		logger -t vigil "crashed (signal $sig); starting it again in ${delay}s" 2>/dev/null
		sleep "$delay" &
		waiting=$!
		wait "$waiting"
		waiting=
	done
	release
}

release() {
	[ "$(cat "$SUPERVISOR" 2>/dev/null)" = "$$" ] && rm -f "$SUPERVISOR"
	return 0
}

stop() {
	echo -n "Stopping $DAEMON: "
	lock
	# The supervisor first, so it does not start what is being stopped. It
	# may be caught between its checks and the launch, starting a daemon after
	# the first signal -- so the daemon is asked again every second -- and it
	# exits only once that daemon has ended. The lock is held until the
	# supervisor is gone too, or a start right after this one could race its
	# last steps and lose its own pidfile (#2630).
	sup=
	supervising && sup=$pid
	[ -n "$sup" ] && kill "$sup" 2>/dev/null
	i=0
	while { running || { [ -n "$sup" ] && kill -0 "$sup" 2>/dev/null; }; } && [ $i -lt 10 ]; do
		start-stop-daemon -K -q -x "$DAEMON_PATH"
		i=$((i + 1))
		sleep 1
	done
	# vigil: one that has not ended ten seconds after SIGTERM is hung, and a
	# failed stop would leave it running with its supervisor already gone --
	# nothing to restart it if it then crashes, and sysupgrade's restart of it
	# failing the same way. SIGKILL leaves the media hardware as a crash does,
	# which every start already recovers from (it is how each crash restart
	# begins), so it is used before giving up.
	if running; then
		start-stop-daemon -K -s 9 -q -x "$DAEMON_PATH"
		i=0
		while running && [ $i -lt 5 ]; do
			i=$((i + 1))
			sleep 1
		done
	fi
	# A supervisor still alive at the cutoff could yet launch a daemon:
	# not stopped, and its pid file stays for the next stop to find it.
	if running || { [ -n "$sup" ] && kill -0 "$sup" 2>/dev/null; }; then
		unlock
		echo "FAIL"
		return 1
	fi
	rm -f "/var/run/$DAEMON.pid" "$SUPERVISOR"
	unlock
	echo "OK"
}

case "$1" in
	start|stop)
		$1
		;;

	supervise)
		supervise
		;;

	watch)
		rec_watch "$2" "$3"
		;;

	restart)
		stop || exit 1
		sleep 3
		start
		;;

	reload)
		# vigil: no reload signal. A change made through the API is applied
		# while vigild runs; a hand edit of $CONFIG needs a fresh start.
		stop || exit 1
		start
		;;

	*)
		echo "Usage: $0 {start|stop|restart|reload}"
		exit 1
		;;
esac
