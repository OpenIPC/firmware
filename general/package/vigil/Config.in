config BR2_PACKAGE_VIGIL
	bool "vigil"
	# The platform's media stack, which the board's defconfig enables: a
	# vigil platform per osdrv package.
	depends on BR2_PACKAGE_HISILICON_OSDRV_HI3536DV100 || \
		BR2_PACKAGE_SIGMASTAR_OSDRV_INFINITY2M
	depends on BR2_LINUX_KERNEL
	depends on !BR2_PACKAGE_MAJESTIC
	depends on !BR2_PACKAGE_VDEC_OPENIPC
	select BR2_PACKAGE_LIBYAML
	select BR2_PACKAGE_MBEDTLS_OPENIPC
	help
	  vigil - DVR/NVR application: network cameras (RTSP, NETIP)
	  decoded to HDMI in a 2x2 view with a status UI, and recorded
	  without re-encoding.

	  Installs /usr/bin/vigild, /etc/init.d/S95vigil (started at
	  boot and restarted after a crash, as majestic is) and
	  /etc/vigil.yaml (cameras, recording, the API), a YAML file
	  like majestic's, which vigild keeps itself: it rewrites it
	  when settings change, with each setting explained in a
	  comment (comments written by hand are not kept). Its
	  HTTP/WebSocket API listens on port 8080 and asks for root's
	  password, which it refuses to accept while root has none (an
	  unclaimed image). The API is plain HTTP: the password crosses
	  the network in clear on every request, as with the camera web
	  UI, so use it on a trusted network or through an SSH tunnel, or
	  set api.listen to 127.0.0.1:8080. An /etc/vigil.json from an
	  earlier image is converted into vigil.yaml once, and kept as
	  vigil.json.migrated; the vigil.yaml of images before that one
	  is read as it is. vigild records only onto a mounted disk, card
	  or share, never onto the flash or into RAM, and starts recording
	  by itself once the disk is there.

	  https://github.com/OpenIPC/vigil
