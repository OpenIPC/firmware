# Build-time defaults for the read-only root filesystem.
# Override in /etc/default/t23-ipa on the overlay and restart S80t23-ipa.
INPUT=0
TUNING_FILE=
AE_MODE=auto
AWB_MODE=auto
# Leave DAYNIGHT_MODE empty so t23-ipa picks its per-input default
# (auto for input 0, follow for secondary inputs); set auto|day|night|follow to override.
DAYNIGHT_MODE=
FLICKER_HZ=0
MIN_FPS=15
ILLUMINATOR=ir:illumination
EXTRA_ARGS=
