config BR2_PACKAGE_NOVATEK_OPENSDK
	bool "novatek-opensdk"
	default n
	depends on BR2_LINUX_KERNEL
	help
	  Opensource Novatek SoCs SDK: sensor drivers (nvt_sen_*.ko) built
	  from source against the firmware kernel.

	  https://github.com/OpenIPC/opennovatek

comment "NOVATEK_OPENSDK needs a Linux kernel to be built"
	depends on !BR2_LINUX_KERNEL
