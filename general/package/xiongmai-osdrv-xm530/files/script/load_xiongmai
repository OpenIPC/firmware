#!/bin/sh
chipid=$(ipcinfo --chip-name)
[ "${chipid}" = "xm550" ] && MEM_ALL=128 || MEM_ALL=64

MODULE=/lib/modules/3.10.103+/xiongmai
MEM_START=0x800
MEM_SAMALL_LIN=0x1

MEM_OS=$(tr ' ' '\n' </proc/cmdline | sed -n 's/^mem=\([0-9]*\)M$/\1/p' | head -1)
MEM_LEN=$(echo "$MEM_ALL $MEM_OS"|awk '{printf("0x%03x00000",$1-$2)}')
MEM_START=$(echo "$MEM_START $MEM_SAMALL_LIN $MEM_OS"|awk '{printf("0x%03x00000",$1+$2*$3)}')
echo MEM_START="$MEM_START" MEM_LEN="$MEM_LEN"
VI_BUFF=2

report_error() {
	echo "******* Error: There's something wrong, please check! *****"
	exit 1
}

insert_audio() {
	echo "insert audio"
	insmod xm_i2s.ko
	insmod acodec.ko
}

insert_h265() {
	echo "insert h265"
	insmod mve_rsrc.ko
	insmod mve_base.ko
}

insert_vo() {
	regs 20000000 1
	regs 20000010 12042d02
	regs 20000044 0x2777
	regs 20000048 0x3
	regs 2000004C 01020102
	regs 20000000 0

	insmod xm530_vo.ko
	insmod xm530_vdec.ko
}

remove_audio() {
	echo "remove audio"
	rmmod -w acodec
	rmmod -w xm_i2s
}

# VI: the open driver when xiongmai-opensdk installed it (OpenIPC/openxiongmai
# drivers/xm_vi, the same /dev/vi without the vendor module's freeze at VI init
# and its vmalloc leak), the vendor's otherwise. mmz is loaded by then.
insert_vi() {
	modprobe open_vi buffer=$VI_BUFF 2>/dev/null ||
		insmod xm530_vi.ko buffer=$VI_BUFF
}

# MMZ, likewise: the open driver when installed, the vendor's otherwise. An
# image with open_mmz keeps the vendor module outside the depmod tree, so the
# two do not both provide the same symbols. Without either, nothing that
# needs one can load.
#
# set_allocator cma boots with the media share as a CMA area (cma=) and leaves
# only the top 1 MB out of Linux, for xm530_rgn: open_mmz then takes every
# other block from CMA. Only open_mmz can, and the fixed zone is 1 MB then, so
# a failure there stops the media modules rather than start them on it.
insert_mmz() {
	vendor_mmz=mmz.ko
	[ -f "$vendor_mmz" ] || vendor_mmz=/usr/lib/xiongmai/mmz.ko
	if grep -q "mmz_allocator=cma" /proc/cmdline; then
		modprobe open_mmz allocator=cma mmz_start="$MEM_START" \
			mmz_size="$MEM_LEN" && return
		logger -s -p daemon.err -t xiongmai \
			"open_mmz allocator=cma failed; set_allocator xm restores the fixed zone"
		report_error
	fi
	modprobe open_mmz mmz_start="$MEM_START" mmz_size="$MEM_LEN" 2>/dev/null ||
		insmod "$vendor_mmz" mmz_start="$MEM_START" mmz_size="$MEM_LEN" ||
		report_error
}

remove_mmz() {
	rmmod -w open_mmz 2>/dev/null || rmmod -w mmz
}

# The ISP device: OpenIPC/openxiongmai drivers/xm530_isp (open_isp.ko), when
# xiongmai-opensdk installed it, the vendor's xm530_isp.ko otherwise.
insert_isp() {
	modprobe open_isp 2>/dev/null || modprobe xm530_isp
}

remove_isp() {
	rmmod -w open_isp 2>/dev/null || rmmod -w xm530_isp
}

# Regions (OSD): OpenIPC/openxiongmai drivers/xm530_rgn (open_rgn.ko), when
# xiongmai-opensdk installed it, the vendor's xm530_rgn.ko otherwise. The open
# one keeps its bitmaps in its own memory, not in an MMZ block.
insert_rgn() {
	modprobe open_rgn 2>/dev/null || modprobe xm530_rgn
}

remove_rgn() {
	rmmod -w open_rgn 2>/dev/null || rmmod -w xm530_rgn
}

remove_vi() {
	rmmod -w open_vi 2>/dev/null || rmmod -w xm530_vi
}

insert_sns() {
	#Sensor clock 27MHz
	#regs 0x2000002c 1;
	#regs 0x2000000c 0x10110010;
	#regs 0x20000010 0x901F0010;
	#regs 0x20000014 0x01120000;
	#regs 0x2000002c 0;
	#sleep 0.1;
	insmod xm_i2c.ko;
}

remove_sns() {
	rmmod -w xm_i2c &> /dev/null
	rmmod -w ssp_sony &> /dev/null
}

insert_ko() {
	# driver load
	insert_sns > /dev/null
	insert_mmz
	insert_vi
	insert_isp
	insert_rgn
	insmod xm530_h264.ko
	insmod xm_rtc.ko
	# The watchdog is the kernel's sp805_wdt (/dev/watchdog), not xm_wdt.ko: see
	# OpenIPC/firmware#2611.
	insmod log.ko
	insert_audio
	insert_h265
	#insert_vo
}

remove_ko() {
	remove_audio
	rmmod -w xm_rtc
	rmmod -w xm530_h264
	remove_rgn
	remove_isp
	remove_vi
	remove_mmz
	remove_sns
}

make_symlink() {
	if [ ! -f /usr/lib/libsns.so ]; then
		SNS_TYPE=$(ipcinfo --short-sensor)
		logger -s -p daemon.info -t xiongmai "You sensor is $SNS_TYPE and symlink to libsns.so not found"

		# Sensors driven by libsns_X50_XM530 (see the openxiongmai README) that
		# ipcinfo names unambiguously; everything else is in X123.
		case $SNS_TYPE in
			imx335|sc335e|sc5235|sc5332)
				logger -s -p daemon.info -t xiongmai "Create new symlink to libsns_X50_XM530.so"
				ln -sf /usr/lib/sensors/libsns_X50_XM530.so /usr/lib/libsns.so
				;;
			*)
				logger -s -p daemon.info -t xiongmai "Create new symlink to libsns_X123_XM530.so"
				ln -sf /usr/lib/sensors/libsns_X123_XM530.so /usr/lib/libsns.so
				;;
		esac
	fi
}

# The Dashboard, the default hostname (S31hostname) and extutils read the
# sensor out of the U-Boot environment, which every other vendor's load script
# fills in. This one never did, so every Xiongmai camera showed "unknown" there
# whatever ipcinfo detected (OpenIPC/openxiongmai#8). Probed once the sensor
# clock and I2C are up, and written only when the variable is missing: a value
# already there is the owner's, and a failed probe is never stored, which would
# latch it (#2428).
record_sensor() {
	command -v fw_setenv >/dev/null 2>&1 || return 0
	[ -n "$(fw_printenv -n sensor 2>/dev/null)" ] && return 0
	local sensor
	sensor=$(ipcinfo --short-sensor 2>/dev/null)
	case "$sensor" in "" | unknown) return 0 ;; esac
	fw_setenv sensor "$sensor" &&
		logger -s -p daemon.info -t xiongmai "Writing $sensor to U-Boot ENV"
}

load_usage() {
	echo "Usage: $0 [-option]"
	echo "options:"
	echo "    -i                  insert modules"
	echo "    -r                  remove modules"
	echo "    -h                  help information"
	echo -e "for example: ./loadxm530 -i\n"
}

# load module.
if [ "$1" = "-i" ]; then
	cd $MODULE
	insert_ko
	make_symlink
	record_sensor
fi

if [ "$1" = "-r" ]; then
	remove_ko
fi

if [ "$1" = "-h" ]; then
	load_usage
	exit
fi

if [ $# -eq 0 ] || [ "$1" = "-a" ]; then
	remove_ko
	insert_ko
fi
