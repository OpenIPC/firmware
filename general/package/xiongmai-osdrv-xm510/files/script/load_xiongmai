#!/bin/sh
# Useage: ./load3518 [ -r|-i|-a ] [ sensor ]
#         -r : rmmod all modules
#         -i : insmod all modules
#    default : rmmod all moules and then insmod them
#


# AR0130 MN34031 IMX104 ICX692 OV9712 9M034 IMX122 MT9P006 IMX138 SOIH22 OV2710 HIMAX1375 IMX225


#内存和地址单位M
MEM_ALL=32
MEM_START=0x800
MEM_SAMALL_LIN=0x1

MEM_OS=`cat /proc/cmdline  | awk '{print $1}' | sed -e 's/mem=//' -e 's/M//'`
MEM_LEN=`echo "$MEM_ALL $MEM_OS"|awk '{printf("0x%03x00000",$1-$2)}'`
MEM_START=`echo "$MEM_START $MEM_SAMALL_LIN $MEM_OS"|awk '{printf("0x%03x00000",$1+$2*$3)}'`
echo MEM_START=$MEM_START  MEM_LEN=$MEM_LEN


if [ $MEM_LEN == 0x00e00000 ];then
VI_BUFF=3
else 
VI_BUFF=2
fi

SNS_A=AR0130

if [ $# -ge 2 ]; then
SNS_A=$2
fi

report_error()
{
	echo "******* Error: There's something wrong, please check! *****"
	exit 1
}

insert_audio()
{
	echo "insert audio"
	insmod gpioi2c.ko
	insmod xm_i2s.ko
	insmod acodec.ko
}

remove_audio()
{
	echo "remove audio"
	rmmod -w acodec
	rmmod -w xm510_i2s
	rmmod -w gpioi2c
}

insert_sns()
{
    #Sensor clock 27MHz
	devmem 0x2000002c 32 1;
	devmem 0x2000000c 32 0x10110010;
	devmem 0x20000010 32 0x901F0010;
	devmem 0x20000014 32 0x01120000;
	devmem 0x2000002c 32 0;
	sleep 0.1;
	insmod xm_i2c.ko;
}

remove_sns()
{
	rmmod -w xm_i2c &> /dev/null
	rmmod -w ssp_sony &> /dev/null
}

# MMZ, VI, the ISP, regions and the encoder: the open drivers when
# xiongmai-opensdk-xm510 installed them (OpenIPC/openxiongmai drivers/xm_mmz,
# drivers/xm510_vi, drivers/xm510_isp, drivers/xm510_rgn and drivers/hx280enc),
# the vendor modules otherwise, which depmod indexes here
# under xiongmai/. None of the open modules needs a vendor module's symbols.
insert_mmz()
{
	modprobe open_mmz mmz_start=$MEM_START mmz_size=$MEM_LEN 2>/dev/null ||
		modprobe mmz mmz_start=$MEM_START mmz_size=$MEM_LEN ||
		report_error
}

remove_mmz()
{
	rmmod -w open_mmz 2>/dev/null || rmmod -w mmz
}

# The vendor xm510_vi.ko depends on mmz. With the vendor mmz.ko loaded,
# modprobe resolves that; on open_mmz it would load the vendor mmz.ko beside
# it, which open_mmz refuses ("exports duplicate symbol mmz_alloc"), failing
# the load, so there it is insmod, which takes the symbols open_mmz exports.
insert_vi()
{
	modprobe open_vi buffer=$VI_BUFF 2>/dev/null && return
	if grep -q "^mmz " /proc/modules; then
		modprobe xm510_vi buffer=$VI_BUFF
	else
		insmod xm510_vi.ko buffer=$VI_BUFF
	fi
}

remove_vi()
{
	rmmod -w open_vi 2>/dev/null || rmmod -w xm510_vi
}

insert_isp()
{
	modprobe open_isp 2>/dev/null || modprobe xm510_isp
}

remove_isp()
{
	rmmod -w open_isp 2>/dev/null || rmmod -w xm510_isp
}

# The vendor xm510_rgn.ko depends on mmz, as xm510_vi.ko does: insmod on
# open_mmz, modprobe on the vendor mmz.ko.
insert_rgn()
{
	modprobe open_rgn 2>/dev/null && return
	if grep -q "^mmz " /proc/modules; then
		modprobe xm510_rgn
	else
		insmod xm510_rgn.ko
	fi
}

remove_rgn()
{
	rmmod -w open_rgn 2>/dev/null || rmmod -w xm510_rgn
}

insert_h264()
{
	modprobe open_h264 2>/dev/null || modprobe xm510_h264
}

remove_h264()
{
	rmmod -w open_h264 2>/dev/null || rmmod -w xm510_h264
}

insert_ko()
{
# low power control
	#source ./lowpower.sh > /dev/null

# pinmux configuration
	#source ./pinmux_xm510.sh rmii i2c > /dev/null

# driver load
	cd /lib/modules/3.0.101/xiongmai/
	insert_sns > /dev/null
	insert_mmz
	insert_vi
	insert_isp
	insert_rgn
	insert_h264
	insmod xm_rtc.ko
	# The watchdog is the kernel's sp805_wdt (/dev/watchdog), not xm_wdt.ko: see
	# OpenIPC/firmware#2611.

	#insert_audio
	echo "==== Your input Sensor type is $SNS_A ===="
}

remove_ko()
{
	#remove_audio
	rmmod -w xm_rtc
	remove_h264
	remove_rgn
	remove_isp
	remove_vi
	remove_mmz

	remove_sns
}

# The Dashboard, the default hostname (S31hostname) and extutils read the
# sensor out of the U-Boot environment, which every other vendor's load script
# fills in. This one never did, so every Xiongmai camera showed "unknown" there
# whatever ipcinfo detected (OpenIPC/openxiongmai#8). Probed once the sensor
# clock and I2C are up, and written only when the variable is missing: a value
# already there is the owner's, and a failed probe is never stored, which would
# latch it (#2428).
record_sensor() {
	command -v fw_setenv >/dev/null 2>&1 || return 0
	[ -n "$(fw_printenv -n sensor 2>/dev/null)" ] && return 0
	local sensor
	sensor=$(ipcinfo --short-sensor 2>/dev/null)
	case "$sensor" in "" | unknown) return 0 ;; esac
	fw_setenv sensor "$sensor" &&
		logger -s -p daemon.info -t xiongmai "Writing $sensor to U-Boot ENV"
}

load_usage()
{
	echo "Usage:  ./loadxm510 [-option] [sensor_name]"
	echo "options:"
	echo "    -i sensor_name           insert modules"
	echo "    -r                       remove modules"
	echo "    -a sensor_name           remove modules first, then insert modules"
	echo "    -h                       help information"
	echo -e "Available sensors: ar0130, h42, imx104, icx692, ov9715, 9m034, imx122, mt9p006"
	echo -e "for example: ./loadxm510 -a ar0130 \n"
}

# load module.
if [ "$1" = "-i" ]
then
cd /lib/modules/3.0.101/xiongmai
insert_ko
record_sensor
fi

if [ "$1" = "-r" ]
then
remove_ko
fi

if [ "$1" = "-h" ]
then
load_usage
exit
fi

if [ $# -eq 0 ] || [ "$1" = "-a" ]
then
remove_ko
insert_ko
fi
