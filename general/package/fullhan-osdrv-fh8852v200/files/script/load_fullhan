#!/bin/sh

set_gpio()
{
    if [ ! -d "/sys/class/gpio/GPIO$1" ]; then
        echo $1 > /sys/class/gpio/export
        echo out > /sys/class/gpio/GPIO$1/direction
    fi

    echo $2 > /sys/class/gpio/GPIO$1/value
}

# The media pool (vmm.ko's mmz) runs from the end of the kernel's memory,
# mem= in the bootargs, to the end of the DDR the PMU reports. A fixed
# 0xA2000000,32M is right only for a 64 MB chip booted with mem=32M: a
# 128 MB FH8856V200 kept 64 MB idle and could not run a second stream, and
# an inherited vendor mem=36M put the kernel 4 MB into the pool, where the
# ISP's buffers then failed to allocate (majestic#354). The fixed layout
# stays as the fallback when either size cannot be read.
pool_layout()
{
	os_mb=$(awk 'BEGIN { RS = "[ \n]" } /^mem=[0-9]+M$/ { sub(/^mem=/, ""); sub(/M$/, ""); print; exit }' \
		"${LOAD_FULLHAN_CMDLINE:-/proc/cmdline}")
	# fh_chipid prints the PMU's DDR size in Mbit; anything but a size these
	# chips are made with is a misread, not a layout to trust.
	ddr_mbit=$(sed -n 's/^ddr_size[[:space:]]*:[[:space:]]*\([0-9][0-9]*\)Mbit$/\1/p' \
		"${LOAD_FULLHAN_CHIP:-/proc/driver/chip}" 2>/dev/null)
	case "$ddr_mbit" in
		512|1024|2048) ddr_mb=$((ddr_mbit / 8)) ;;
		*) ddr_mb= ;;
	esac

	if [ -z "$os_mb" ] || [ -z "$ddr_mb" ] || [ "$os_mb" -lt 16 ] || [ $((ddr_mb - os_mb)) -lt 8 ]; then
		logger -s -t load_fullhan "mem=${os_mb:-?}M on ${ddr_mb:-?} MB of DDR: media pool left at 0xA2000000,32M"
		echo "0xA2000000,32M"
		return
	fi

	pool_mb=$((ddr_mb - os_mb))
	[ "$pool_mb" -lt 32 ] && \
		logger -s -t load_fullhan "mem=${os_mb}M leaves the media pool ${pool_mb}M; the ISP may not start"
	printf '0x%X,%dM\n' $(((0xA00 + os_mb) << 20)) "$pool_mb"
}

cd /lib/modules/4.9.129/fullhan

# mmz:name,0,start,size,type
insmod vmm.ko mmz=anonymous,0,$(pool_layout) anony=1

#reset sensor
set_gpio 13 0

insmod xbus_rpc.ko fn=/lib/firmware/rtthread_arc_FH885xV200.bin fa=0xbff80000

#unreset sensor
set_gpio 13 1

insmod media_process.ko
insmod isp.ko
insmod vpu.ko #vpu_mode=buf_0_2,buf_1_2
insmod enc.ko
insmod jpeg.ko
#insmod bgm.ko