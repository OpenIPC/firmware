#!/bin/sh
CMD=${0##*/}
ARCH=$(uname -m)

if echo "$ARCH" | grep -q mips; then
	ARC="-mips32"
fi

MAJESTIC_CFG=/etc/majestic.yaml

# The path of a -s/-d call on majestic's own config, or empty when this call is
# neither. yaml-cli takes its flags in any order and lets the last mode win
# (src/input_data.c parse_args), so that is mirrored here rather than assuming
# the mode is $1. An explicit -i/-o means some other file -- sensor_cli and the
# wfb applet both rely on that -- and reports nothing.
majestic_write_path() {
	wp= other=0
	while [ $# -gt 0 ]; do
		case "$1" in
			-s | --set)
				[ $# -ge 3 ] || return
				wp=$2
				shift 3
				;;
			-d | --del)
				[ $# -ge 2 ] || return
				wp=$2
				shift 2
				;;
			-g | --get)
				[ $# -ge 2 ] || return
				wp=
				shift 2
				;;
			-i | --input | -o | --output)
				[ $# -ge 2 ] || return
				other=1
				shift 2
				;;
			*)
				shift
				;;
		esac
	done
	[ "$other" = 1 ] || echo "$wp"
}

# The majestic processes that can safely be told to reload.
#
# Process existence is not readiness. S95majestic starts it with
# start-stop-daemon -b, which returns at the fork, so boot carries straight on
# into the S98 scripts while majestic is still working its way down main()
# towards the point where it installs a SIGHUP handler. Until it gets there the
# default action for SIGHUP applies, and that is to terminate -- so a reload
# asked for in that window does not reload the camera, it takes the streamer
# away for the rest of the boot. Measured on a hi3516ev200: the process is
# visible to pidof with SigCgt still 0000000000000000.
#
# /proc/<pid>/status answers the question exactly. SigCgt is the caught-signal
# mask and SIGHUP is signal 1, so it is the lowest bit -- the mask ends in an
# odd hex digit precisely when the handler is installed.
majestic_reload_pids() {
	for pid in $(pidof majestic 2>/dev/null); do
		case "$(sed -n 's/^SigCgt:[[:space:]]*//p' "/proc/$pid/status" 2>/dev/null)" in
			*[13579bdfBDF]) echo "$pid" ;;
		esac
	done
}

# A path yaml-cli will happily store and majestic will never read. The tree
# ships one: t40_lite_movols-mo-805p's customizer.sh says
# `cli -s .video0.bitrate: 4000`, and the trailing colon is why six of that
# device's settings have never applied. Nothing reported it, because writing
# the file cannot fail. Checking the shape is cheap, needs no network, and
# catches the whole class.
majestic_bad_path() {
	case "$1" in
		*[!A-Za-z0-9_.-]*) return 0 ;;
		*..* | *. | .) return 0 ;;
	esac
	return 1
}

# The address a camera may keep as its own.
#
# Shape first: six hex pairs, and the second nibble of the first octet even --
# that bit is the group bit, and a multicast address is not a legal source
# address for a frame the camera sends.
mac_is_valid() {
	echo "$1" | grep -Eiq '^[0-9a-f][02468ace](:[0-9a-f]{2}){5}$' || return 1
	[ "$1" != 00:00:00:00:00:00 ]
}

# 00:00:23:34:45:xx is nobody's address. HiSilicon u-boot bakes
# 00:00:23:34:45:66 into its default env (CONFIG_ETHADDR, in the board
# headers), a full image carries no environment at all so the value is
# whatever u-boot compiled in, and this overlay used to fall back to the same
# literal in two places -- so the fleet converges on it. The last octet tracks
# the bootloader build rather than the camera: a lab hi3516ev300 was found on
# :88, which is why the whole prefix is matched and not one value.
#
# 00:00:23 is a registered OUI that OpenIPC does not own, so no camera has a
# legitimate claim to any of the 256.
mac_is_placeholder() {
	case "$1" in
		00:00:23:34:45:*) return 0 ;;
	esac
	return 1
}

mac_is_own() { mac_is_valid "$1" && ! mac_is_placeholder "$1"; }

# A locally administered unicast address: bit 1 of the first octet set, bit 0
# clear. 02: is the lowest prefix that satisfies both, and holding it fixed
# also makes a self-assigned address recognisable beside a real vendor OUI.
mac_generate() {
	od -An -tx1 -N5 /dev/urandom | tr -d ' ' |
		sed 's/^\(..\)\(..\)\(..\)\(..\)\(..\)$/02:\1:\2:\3:\4:\5/'
}

# The address the camera came with, where a stock firmware left one behind.
# ipcinfo --xm-mac scans the flash for the Xiongmai magic and decodes the MAC
# that follows it. It looks for a magic rather than trusting a partition
# layout, so it is worth trying whatever the SoC vendor says -- xiongmai and
# sigmastar cameras are built on the same stock images as the hisilicon ones
# this was first written for (#1147) -- but only on NOR, which is the only
# place that layout exists.
mac_from_flash() {
	command -v ipcinfo >/dev/null 2>&1 || return 1
	[ "$(ipcinfo -F 2>/dev/null)" = nor ] || return 1
	xmmac=$(ipcinfo --xm-mac 2>/dev/null) || return 1
	mac_is_own "$xmmac" || return 1
	echo "$xmmac"
}

# Where a MAC is kept. The u-boot environment first: sysupgrade never touches
# that partition, so an address stored there survives firstboot, which is what
# a DHCP reservation needs. /etc/ethaddr is for the boards that have no
# fw_setenv at all -- BR2_PACKAGE_UBOOT_TOOLS is off on the two ambarella s2l
# defconfigs -- and lives on the overlay, so firstboot wipes it and the camera
# mints a fresh address next boot.
ETHADDR_FILE=/etc/ethaddr

mac_stored() {
	stored=$(fw_printenv -n ethaddr 2>/dev/null)
	if mac_is_own "$stored"; then echo "$stored"; return 0; fi
	stored=$(cat "$ETHADDR_FILE" 2>/dev/null)
	if mac_is_own "$stored"; then echo "$stored"; return 0; fi
	return 1
}

mac_persist() {
	if command -v fw_setenv >/dev/null 2>&1 && fw_setenv ethaddr "$1" 2>/dev/null; then
		return 0
	fi
	# Braced so the redirection's own failure is suppressed too: `echo >f
	# 2>/dev/null` sets up >f first, and a read-only /etc reports that to the
	# stderr the next word is about to replace.
	{ echo "$1" > "$ETHADDR_FILE"; } 2>/dev/null
}

case "$CMD" in
	cli)
		wpath=$(majestic_write_path "$@")
		if [ -n "$wpath" ] && majestic_bad_path "$wpath"; then
			echo "cli: '$wpath' is not a setting path, nothing written" >&2
			exit 1
		fi

		yaml-cli -i "$MAJESTIC_CFG" "$@"
		rc=$?

		# Writing the file changes nothing that is already running, which is why
		# `cli -s .video0.fps 20` used to report success and leave the camera
		# streaming at the old rate until somebody worked out that a reload was
		# needed. majestic re-reads the file on SIGHUP, diffs it against the tree
		# in force and prices the difference on its own ladder -- a live key is
		# pushed straight at the SDK, a service key restarts only that service,
		# and only a pipeline key rebuilds -- so asking for it here costs the
		# stream nothing for most settings. Repeated signals inside 3s collapse
		# into one reload, so a burst of writes still reloads once.
		#
		# Deliberately conditional on majestic being up AND ready to be signalled:
		# at S30, where customizer.sh seeds a device's config, it is not running at
		# all, and provisioning must stay exactly as it was. This is the pattern
		# wifibroadcast already applies by hand after its own writes.
		if [ "$rc" = 0 ] && [ -n "$wpath" ]; then
			for pid in $(majestic_reload_pids); do
				kill -1 "$pid"
			done
		fi
		exit "$rc"
		;;

	sensor_cli)
		yaml-cli -i /etc/sensor/"$(fw_printenv -n sensor)".yaml "$@"
		;;

	ipctool)
		IPCTOOL=/tmp/ipctool
		if [ ! -x $IPCTOOL ]; then
			curl -s -L -f -o $IPCTOOL https://github.com/OpenIPC/ipctool/releases/download/latest/ipctool"$ARC"
			response=$?
			if [ "$response" -ne 0 ]; then
				echo "Unable to download ipctool. cUrl error code is $response."
				exit $response
			else
				chmod +x $IPCTOOL
				echo "The ipctool installed as remote GitHub plugin"
			fi
		fi
		$IPCTOOL "$@"
		;;

	check_mac)
		# Runs from S30customizer, which is before S40network: S40network reads
		# ethaddr at its own start and interfaces.d/eth0 expands get_mac at ifup
		# time, so an address written here is picked up later in the same boot.
		# That is why this no longer reboots -- #1147 did, and did not need to.
		#
		# A camera that already has an address of its own is left alone. The
		# repair is for the two ways a camera ends up without one: no environment
		# at all after a full-image flash (#2405, a fresh random MAC every boot),
		# and the placeholder every bootloader of a family ships. Duplicates are
		# not cosmetic -- S96onvifserver derives serial_num from the interface
		# MAC, so two cameras sharing an address also claim one ONVIF identity.
		mac_stored >/dev/null && exit 0

		mac=$(mac_from_flash) || mac=$(mac_generate)
		if mac_persist "$mac"; then
			echo "check_mac: assigned $mac"
		else
			echo "check_mac: nowhere to store a MAC address, eth0 keeps the one the kernel picked" >&2
		fi
		;;

	get_mac)
		# Printed straight into `hwaddress ether` by interfaces.d/eth0 and by
		# majestic-webui's setnetwork, so it has to print something busybox ifup
		# will accept whatever else has gone wrong: an empty value makes ifup
		# treat the command as failed and the camera never starts udhcpc.
		#
		# The last resort is therefore the address the interface already carries,
		# which makes the assignment a no-op. A kernel-random MAC that changes
		# each boot is bad; a literal shared with every other camera is worse.
		mac_stored && exit 0
		cat "/sys/class/net/${1:-eth0}/address" 2>/dev/null
		;;

	set_mac)
		# The manual override. With an argument it stores that address; with none
		# it mints a fresh one, which is how two cameras that collided are pulled
		# apart. Unlike check_mac it replaces an address that is already good --
		# being asked is the whole point.
		mac=$1
		if [ -n "$mac" ]; then
			if ! mac_is_valid "$mac"; then
				echo "set_mac: '$mac' is not a unicast MAC address" >&2
				exit 1
			fi
			if mac_is_placeholder "$mac"; then
				echo "set_mac: '$mac' is the placeholder the whole fleet shares" >&2
				exit 1
			fi
		else
			mac=$(mac_generate)
		fi
		if ! mac_persist "$mac"; then
			echo "set_mac: nowhere to store a MAC address" >&2
			exit 1
		fi
		echo "ethaddr: $mac"
		;;

        sysinfo)
		echo ""
		echo "Firmware:"
		echo -e "  $(grep -e OPENIPC_VERSION /etc/os-release)\n"
		echo "Majestic:"
		echo -e "  internal - $(/rom/usr/bin/majestic -v)"
		echo -e "  external - $(/usr/bin/majestic -v)\n"
		echo "USB devices:"
		echo -e "  $(lsusb | awk '{print $6}' | sort | tr '\n' ' ')\n"
		echo "Memory:"
		echo -e "  totalmem - $(fw_printenv -n totalmem)"
		echo -e "  osmem    - $(fw_printenv -n osmem || echo 'not set')\n"
		echo "Processor:"
		echo -e "  detected - $(ipcinfo -ci | tr '\n' '\t')"
		echo -e "  recorded - $(fw_printenv -n soc)\n"
		echo "Sensor:"
		echo -e "  detected - $(ipcinfo -s)"
		echo -e "  recorded - $(fw_printenv -n sensor)\n"
                ;;

        netip_hash)
                echo -n "$@" | md5sum | fold -w 2 | awk 'NR<17{printf "%d\n", "0x"$0}' | sed 'N;s/\n/ /' | awk '{c=($1+$2)%62; if (c<10) c+=48; else if (c<36) c+=55; else c+=61; printf "%c", c}'
                ;;

	*)
		;;
esac
