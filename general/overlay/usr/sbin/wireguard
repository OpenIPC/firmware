#!/bin/sh

config_path="/tmp/wireguard.conf"
delay_start=0
delay_step=10
delay_max=300

. /usr/sbin/common

prepare() {
	read_subshell_pid
	prog="${0##*/}[$subshell_pid]"
}

log() {
	logger -p $1 -t "$prog" "$2"
}

warning() {
	log daemon.warn "$1"
}

info() {
	log daemon.info "$1"
}

ready() {
	echo "$HOST" | grep -qE '^\[|^((^|\.)(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])){4}$' ||
		nslookup "$HOST" >/dev/null 2>&1 || {
			warning "Unable to resolve the WireGuard server hostname"
			return 1
		}
}

finish() {
	{
		echo "#"
		echo "[Interface]"
		echo "PrivateKey = $WG_PRIVKEY"
		echo
		echo "[Peer]"
		echo "Endpoint = $WG_ENDPOINT"
		echo "PersistentKeepalive = $WG_ALIVE"
		echo "PublicKey = $WG_PUBKEY"
		[ -n "$WG_SHARKEY" ] && echo "PresharedKey = $WG_SHARKEY"
		echo "AllowedIPs = $WG_ALLOWED"
		echo "#"
	} >"$config_path"

	run_cmd "Failed to apply WireGuard configuration" "" wg setconf wg0 "$config_path"

	run_cmd "" "" false ip address add dev wg0 "$WG_ADDRESS"
	run_cmd "" "" false ip link set up dev wg0

	for i in $(echo "$WG_ALLOWED" | tr ',' ' '); do
		run_cmd "" "" false ip -4 route add "$i" dev wg0
	done
}

for name in wg_privkey wg_endpoint wg_alive wg_pubkey wg_allowed wg_address; do
	NAME=$(echo "$name" | tr '[:lower:]' '[:upper:]')
	run_cmd "Failed to read U-Boot environment variable $name" $NAME fw_printenv -n $name
done

WG_SHARKEY=$(fw_printenv -n wg_sharkey 2>/dev/null || true)

run_cmd "Failed to load WireGuard module" "" modprobe wireguard
run_cmd "Failed to create wg0 interface" "" ip link add dev wg0 type wireguard

HOST="${WG_ENDPOINT%:*}"

prepare

if ready; then
	finish
else
	{
		prepare
		delay=$delay_start

		while true; do
			[ $delay -lt $delay_max ] && delay=$(( delay + delay_step ))
			sleep $delay
			ready && break
		done

		info "Starting WireGuard connection to $WG_ENDPOINT"
		finish
	} &

	exit 255
fi
