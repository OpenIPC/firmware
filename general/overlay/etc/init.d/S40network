#!/bin/sh
dev=$(fw_printenv -n wlandev)
mac=$(fw_printenv -n wlanmac)
net=$(fw_printenv -n netaddr_fallback)

set_wireless() {
	path=/etc/wireless
	if $path/usb "$dev" || $path/sdio "$dev"; then
		[ -n "$mac" ] && ip link set dev wlan0 address "$mac"
		# A radio with no network to join is not a way in yet -- S97qrscan
		# waits for credentials on exactly such a camera, and brings wlan0 up
		# itself to try the ones it is shown -- so until there is a network
		# the wired port keeps DHCP. A device profile that set wlandev on
		# first boot otherwise left a camera on Ethernet at 192.168.2.10,
		# unreachable from the network it was plugged into. wlan0 gets no
		# DHCP of its own meanwhile, as qrscan's restore does not either: with
		# no server on either side, both would take udhcpc's leasefail
		# address, and the camera would answer on one subnet from two ports.
		if [ -z "$(fw_printenv -n wlanssid 2>/dev/null)" ]; then
			[ -e /sys/class/net/eth0 ] && ifup eth0
			return 0
		fi
		ifup wlan0
	elif $path/modem "$dev"; then
		ifup usb0
		ifup eth1
	fi
	# get_mac, not fw_printenv: this branch never calls ifup eth0, so it is
	# the only thing that puts a MAC on a wireless camera's wired port, and
	# the environment is not the whole answer -- a board with no fw_setenv
	# keeps its address in /etc/ethaddr instead, and get_mac knows both.
	[ -e /sys/class/net/eth0 ] && ifconfig eth0 "${net:-192.168.2.10}" hw ether "$(get_mac eth0)" up
}

start() {
	echo "Starting network..."
	ifup lo
	if [ -n "$dev" ]; then
		set_wireless
	else
		ifup eth0
	fi
}

stop() {
	echo "Stopping network..."
	ifdown lo
	ifdown -f wlan0
	ifdown -f usb0
	ifdown -f eth1
	ifdown -f eth0
}

case "$1" in
	start|stop)
		$1
		;;

	restart|reload)
		stop
		start
		;;

	*)
		echo "Usage: $0 {start|stop|restart|reload}"
		exit 1
		;;
esac
