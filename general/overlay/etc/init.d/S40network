#!/bin/sh
dev=$(fw_printenv -n wlandev)
mac=$(fw_printenv -n wlanmac)
net=$(fw_printenv -n netaddr_fallback)

# Dual mode: a camera with a cable port and a configured WiFi keeps both up and
# prefers the cable. eth0 gets DHCP whenever it has a link, and wlan0 joins as
# well, its routes ranked behind (default.script's metric). The cable was
# parked on a static 192.168.2.10 as soon as WiFi was configured, so a camera
# moved onto a device profile that sets wlandev fell off the wired network it
# was installed on. `fw_setenv netmode wifi` keeps that old layout.
#
# The watcher below is what makes the cable plug-and-play: it starts eth0's
# DHCP once there is a link, releases the lease when the cable goes -- so
# traffic moves to wlan0 within seconds -- and renews it when the cable comes
# back. It polls carrier rather than leaning on ignore_routes_with_linkdown,
# which the 3.x kernels in the tree do not have, and which would leave a pulled
# cable's address and DNS in place. read and sleep are ash builtins, so a poll
# forks nothing.
WATCHER=/var/run/network-watch.pid
FALLBACK=/var/run/network.fallback
POLL=1
DOWN_AFTER=2
SETTLE=5

set_wireless() {
	path=/etc/wireless
	if $path/usb "$dev" || $path/sdio "$dev"; then
		[ -n "$mac" ] && ip link set dev wlan0 address "$mac"
		# A radio with no network to join is not a way in yet -- S97qrscan
		# waits for credentials on exactly such a camera, and brings wlan0 up
		# itself to try the ones it is shown -- so until there is a network
		# the wired port keeps DHCP. A device profile that set wlandev on
		# first boot otherwise left a camera on Ethernet at 192.168.2.10,
		# unreachable from the network it was plugged into. wlan0 gets no
		# DHCP of its own meanwhile, as qrscan's restore does not either: with
		# no server on either side, both would take udhcpc's leasefail
		# address, and the camera would answer on one subnet from two ports.
		if [ -z "$(fw_printenv -n wlanssid 2>/dev/null)" ]; then
			[ -e /sys/class/net/eth0 ] && ifup eth0
			return 0
		fi
		if dual; then
			start_dual wlan0
			return 0
		fi
		ifup wlan0
	elif $path/modem "$dev"; then
		ifup usb0
		ifup eth1
	elif dual; then
		# WiFi was asked for and its driver did not load. The cable is all
		# that is left, so it gets DHCP rather than a static address.
		start_dual
		return 0
	fi
	# get_mac, not fw_printenv: this branch never calls ifup eth0, so it is
	# the only thing that puts a MAC on a wireless camera's wired port, and
	# the environment is not the whole answer -- a board with no fw_setenv
	# keeps its address in /etc/ethaddr instead, and get_mac knows both.
	[ -e /sys/class/net/eth0 ] && ifconfig eth0 "${net:-192.168.2.10}" hw ether "$(get_mac eth0)" up
}

dual() {
	[ -e /sys/class/net/eth0 ] && [ "$(fw_printenv -n netmode 2>/dev/null)" != wifi ]
}

# $1: the WiFi interface to bring up beside the cable, if any.
start_dual() {
	echo "${net:-192.168.2.10}" > "$FALLBACK"
	# With both ports on one subnet each must answer ARP for its own
	# address only, or peers learn the WiFi MAC for the cable's address
	# and the traffic the cable should carry goes over the air.
	for i in eth0 $1; do
		c=/proc/sys/net/ipv4/conf/$i
		[ -w "$c/arp_ignore" ] && echo 1 > "$c/arp_ignore"
		[ -w "$c/arp_announce" ] && echo 2 > "$c/arp_announce"
	done
	# Link up, no address yet: carrier is only reported on an interface
	# that is up, and the watcher starts DHCP once it is. A camera with no
	# cable in pays nothing at boot for a port it is not using.
	ifconfig eth0 hw ether "$(get_mac eth0)" up
	[ -n "$1" ] && ifup "$1"
	watch_start
}

# The watcher's pid, if it is the watcher still: a pid in a file can have been
# reused by anything since. As in S95majestic.
watching() {
	pid=$(cat "$WATCHER" 2>/dev/null)
	[ -n "$pid" ] || return 1
	set -- $(tr '\0' ' ' < "/proc/$pid/cmdline" 2>/dev/null)
	[ $# -ge 2 ] || return 1
	eval "script=\${$(($# - 1))} last=\${$#}"
	[ "$last" = watch ] && [ "${script##*/}" = "${0##*/}" ]
}

watch_start() {
	watching && return 0
	(
		trap '' HUP
		exec sh "$0" watch
	) </dev/null >/dev/null 2>&1 &
	echo $! > "$WATCHER"
}

watch_stop() {
	if watching; then
		kill "$pid" 2>/dev/null
		# The TERM is taken only once an ifup in progress returns.
		i=0
		while kill -0 "$pid" 2>/dev/null && [ $i -lt 10 ]; do
			i=$((i + 1))
			sleep 1
		done
	fi
	rm -f "$WATCHER"
}

# eth0's udhcpc, and only a udhcpc: a pid in a file can have been reused.
# A static stanza has none.
dhcp_pid() {
	upid=$(cat /var/run/udhcpc.eth0.pid 2>/dev/null)
	[ -n "$upid" ] || return 1
	comm=
	read -r comm 2>/dev/null < "/proc/$upid/comm"
	[ "$comm" = udhcpc ]
}

# Take eth0 out of the way of wlan0. On DHCP, USR2 releases the lease
# (deconfig drops the address, its routes and its DNS). A static address has
# no lease, and its gateway route would outlive the cable and swallow the
# traffic wlan0 could carry, so the address goes -- its routes with it -- and
# the link stays up, where its carrier can still be read.
eth0_release() {
	if dhcp_pid; then
		kill -USR2 "$upid" 2>/dev/null
	else
		ip -4 addr flush dev eth0
	fi
}

# Bring eth0 back. On DHCP, USR1 asks for the lease again. A static stanza is
# applied afresh, and that bounces the link through ifup's hwaddress hook:
# returns 0 then, so the caller waits the bounce out.
eth0_restore() {
	if dhcp_pid; then
		kill -USR1 "$upid" 2>/dev/null
		return 1
	fi
	ifdown -f eth0 >/dev/null 2>&1
	ifup eth0 >/dev/null 2>&1
	return 0
}

# eth0's link, each poll: up (carrier), down (no carrier), admin (brought down
# by hand -- the kernel has already flushed its routes, so nothing to do), or
# gone.
link_state() {
	flags=
	read -r flags 2>/dev/null < /sys/class/net/eth0/flags
	if [ -z "$flags" ]; then
		link=gone
	elif [ $((flags & 1)) -eq 0 ]; then
		link=admin
	else
		carrier=
		read -r carrier 2>/dev/null < /sys/class/net/eth0/carrier
		[ "$carrier" = 1 ] && link=up || link=down
	fi
}

watch() {
	trap '' HUP
	trap 'rm -f "$WATCHER"; exit 0' TERM INT
	echo $$ > "$WATCHER"
	# pending: no DHCP yet. settling: the link was just bounced -- by
	# ifup's hwaddress hook, or by hand -- and autonegotiation takes
	# longer than DOWN_AFTER polls to bring carrier back, so a missing
	# carrier counts only after SETTLE polls. Measured on an hi3516ev300:
	# `ip link set eth0 up` had no carrier for about 2 s. up/down: the
	# lease is held/released.
	state=pending
	lost=0
	renew=
	while :; do
		link_state
		case "$state:$link" in
		pending:up)
			ifup eth0
			state=settling
			renew=
			lost=0
			;;
		settling:up)
			# Brought down by hand, the kernel flushed eth0's routes;
			# restoring puts the default route back.
			state=up
			if [ -n "$renew" ]; then
				renew=
				eth0_restore && state=settling
			fi
			lost=0
			;;
		settling:down | up:down)
			lost=$((lost + 1))
			limit=$DOWN_AFTER
			[ "$state" = settling ] && limit=$SETTLE
			if [ $lost -ge $limit ]; then
				logger -t network "eth0 link lost, taking it down; wlan0 carries the traffic"
				eth0_release
				state=down
				lost=0
			fi
			;;
		down:up)
			logger -t network "eth0 link back, bringing it up"
			state=up
			eth0_restore && state=settling
			lost=0
			;;
		up:admin | settling:admin)
			state=admin
			;;
		admin:up | admin:down)
			state=settling
			renew=1
			lost=0
			;;
		*:up)
			lost=0
			;;
		esac
		sleep $POLL
	done
}

start() {
	echo "Starting network..."
	rm -f "$FALLBACK"
	ifup lo
	if [ -n "$dev" ]; then
		set_wireless
	else
		ifup eth0
	fi
}

stop() {
	echo "Stopping network..."
	# The watcher first, so it does not bring back what is being stopped.
	watch_stop
	rm -f "$FALLBACK"
	ifdown lo
	ifdown -f wlan0
	ifdown -f usb0
	ifdown -f eth1
	ifdown -f eth0
}

case "$1" in
	start|stop)
		$1
		;;

	restart|reload)
		stop
		start
		;;

	watch)
		watch
		;;

	*)
		echo "Usage: $0 {start|stop|restart|reload}"
		exit 1
		;;
esac
