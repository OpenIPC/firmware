#!/bin/sh
dev=$(fw_printenv -n wlandev)
mac=$(fw_printenv -n wlanmac)
net=$(fw_printenv -n netaddr_fallback)

set_wireless() {
	path=/etc/wireless
	wired=static
	if $path/usb "$dev" || $path/sdio "$dev"; then
		[ -n "$mac" ] && ip link set dev wlan0 address "$mac"
		ifup wlan0
		# A radio with no network to join is not a way in yet -- S97qrscan
		# waits for credentials on exactly such a camera -- so the wired
		# port keeps DHCP until there is one. A device profile that set
		# wlandev on first boot otherwise left a camera on Ethernet at
		# 192.168.2.10, unreachable from the network it was plugged into.
		[ -z "$(fw_printenv -n wlanssid 2>/dev/null)" ] && wired=dhcp
	elif $path/modem "$dev"; then
		ifup usb0
		ifup eth1
	fi
	[ -e /sys/class/net/eth0 ] || return 0
	if [ "$wired" = dhcp ]; then
		ifup eth0
	else
		# get_mac, not fw_printenv: this branch never calls ifup eth0, so it
		# is the only thing that puts a MAC on a wireless camera's wired
		# port, and the environment is not the whole answer -- a board with
		# no fw_setenv keeps its address in /etc/ethaddr instead, and get_mac
		# knows both.
		ifconfig eth0 "${net:-192.168.2.10}" hw ether "$(get_mac eth0)" up
	fi
}

start() {
	echo "Starting network..."
	ifup lo
	if [ -n "$dev" ]; then
		set_wireless
	else
		ifup eth0
	fi
}

stop() {
	echo "Stopping network..."
	ifdown lo
	ifdown -f wlan0
	ifdown -f usb0
	ifdown -f eth1
	ifdown -f eth0
}

case "$1" in
	start|stop)
		$1
		;;

	restart|reload)
		stop
		start
		;;

	*)
		echo "Usage: $0 {start|stop|restart|reload}"
		exit 1
		;;
esac
