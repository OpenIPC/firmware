#!/bin/sh
#
# Late-boot LED state: green on (or all off when led_disabled=1).
# GPIO 0 = green (active low), GPIO 9 = red (active low), GPIO 4 = bottom red (active high).

case "$1" in
	start | "")
		if [ "$(fw_printenv -n led_disabled 2>/dev/null)" = "1" ]; then
			gpio set 0; gpio set 9; gpio clear 4
		else
			gpio clear 0; gpio set 9; gpio clear 4
		fi
		;;
	stop)
		gpio set 0; gpio set 9; gpio clear 4
		;;
esac

exit 0
