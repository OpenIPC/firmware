#!/bin/sh

case "$1" in
	start)
		echo "Loading kernel modules..."
		[ -r /etc/modules ] || exit 0
		while read module args; do
			case "$module" in
				""|"#"*)
					continue
					;;
			esac
			# One argument per parameter: quoted, "a=1 b=2" reached modprobe
			# as a single word and a line with two parameters never loaded
			# ("gpiostep pan_gpios=... tilt_gpios=..."). Globbing is off, so
			# a value is passed as written.
			set -f
			# shellcheck disable=SC2086
			modprobe "$module" $args > /dev/null
			set +f
		done < /etc/modules
		;;

	stop)
		;;

	*)
		echo "Usage: $0 {start}"
		exit 1
		;;
esac
