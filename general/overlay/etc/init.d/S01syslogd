#!/bin/sh

DAEMON="syslogd"

# Size (KiB) of the in-RAM circular log buffer. Defaults to 64 KiB so stock
# cameras spend no extra memory; the WebUI (Information > Logs) can raise it by
# writing SYSLOG_SIZE to /etc/default/syslogd for users who want more backlog.
SYSLOG_SIZE=64

# Where to forward log lines, as host[:port]; empty keeps everything local,
# which is what a camera does unless somebody asks otherwise. The buffer above
# is in RAM and circular, so the evidence for whatever took a camera down is
# gone by the next boot -- see #2384, where the kernel lines that identify a
# failing SD card existed only on the camera that had just lost it.
SYSLOG_REMOTE=

[ -r /etc/default/syslogd ] && . /etc/default/syslogd

# One destination, and nothing the shell can take apart. `.` above has already
# swallowed an unquoted `host1 host2` as a command prefix -- which leaves
# SYSLOG_REMOTE unset, forwarding off, and a bare "not found" as the only clue
# -- and a quoted one would reach the unquoted expansion below to be split or
# globbed. Refuse it out loud and keep logging locally, rather than forward
# nowhere in silence.
case "${SYSLOG_REMOTE}" in
*[!A-Za-z0-9.:_-]*)
	echo "syslogd: SYSLOG_REMOTE is not a bare host[:port], ignoring: ${SYSLOG_REMOTE}"
	SYSLOG_REMOTE=
	;;
esac

# -L as well as -R, never -R alone: without it busybox forwards the lines
# INSTEAD of keeping them, and both logread and the WebUI's Information > Logs
# page go silent. Enabling forwarding should add a destination, not replace the
# one people already use.
DAEMON_ARGS="-n -C${SYSLOG_SIZE:-64} -t${SYSLOG_REMOTE:+ -L -R ${SYSLOG_REMOTE}}"

# Find the daemon by name, never through a pidfile. Given -p, busybox
# start-stop-daemon inspects only the pid that file holds and never scans
# /proc, so the moment that pid is stale it can no longer see the live daemon:
# -S starts a second copy, and -K without -x signals whatever unrelated process
# has since reused the pid. -x scans every process instead. The name form is
# required here rather than an absolute path: syslogd is a busybox applet, so
# /proc/PID/exe points at /bin/busybox and only argv[0] identifies the daemon.
running() {
	start-stop-daemon -t -K -q -x "$DAEMON"
}

start() {
	echo -n "Starting $DAEMON${SYSLOG_REMOTE:+ (forwarding to ${SYSLOG_REMOTE})}: "
	start-stop-daemon -b -S -q -x "$DAEMON" -- $DAEMON_ARGS
	case $? in
		0) echo "OK"; return 0 ;;
		1) echo "OK (already running)"; return 0 ;;
		*) echo "FAIL"; return 1 ;;
	esac
}

stop() {
	echo -n "Stopping $DAEMON: "
	start-stop-daemon -K -q -x "$DAEMON"
	i=0
	while running && [ $i -lt 10 ]; do
		i=$((i + 1))
		sleep 1
	done
	if running; then
		echo "FAIL"
		return 1
	fi
	rm -f "/var/run/$DAEMON.pid"
	echo "OK"
}

case "$1" in
	start|stop)
		$1
		;;

	restart|reload)
		stop || exit 1
		sleep 1
		start
		;;

	*)
		echo "Usage: $0 {start|stop|restart|reload}"
		exit 1
		;;
esac
