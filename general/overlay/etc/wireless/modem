#!/bin/sh
#
# rndis_host always loads before usbserial: a modem that is already enumerated
# when the generic serial driver arrives loses its RNDIS data interface to it,
# and usb0 never appears.

set_gpio() {
	[ "$2" -eq 1 ] && gpio set $1 || gpio clear $1
	sleep 1
}

# Generic RNDIS
if [ "$1" = "rndis-generic" ]; then
	modprobe rndis_host
	sleep 5
	exit 0
fi

# Huawei E3372H and eth1
if [ "$1" = "rndis-e3372h" ]; then
	usb_modeswitch -v 0x12d1 -p 0x1f01 -c /usr/share/usb_modeswitch/12d1:1f01
	modprobe rndis_host
	sleep 5
	exit 0
fi

# GK7205V200 Kafei with A7680C and usb0
if [ "$1" = "a7680c-gk7205v200-kafei" ]; then
	set_gpio 57 0
	modprobe rndis_host
	modprobe usbserial vendor=0x1e0e product=0x9011
	sleep 15
	exit 0
fi

# GK7205V200 Vixand with Quectel EC200N-CN and usb0
if [ "$1" = "ec200n-gk7205v200-vixand" ]; then
	set_gpio 0 0
	modprobe rndis_host
	modprobe usbserial vendor=0x2c7c product=0x6002
	sleep 10
	exit 0
fi

# T31 CamHi with Quectel EC200S-CN, EC200T-EU and usb0
if [ "$1" = "ec200s-t31-camhi" ]; then
	set_gpio 61 0
	modprobe rndis_host
	modprobe usbserial vendor=0x2c7c product=0x6026
	sleep 10
	exit 0
fi

# T31 CamHi with Quectel EC800G-CN and usb0
if [ "$1" = "ec800g-t31-camhi" ]; then
	set_gpio 61 0
	modprobe rndis_host
	modprobe usbserial vendor=0x2c7c product=0x904
	sleep 10
	exit 0
fi

# T31 CamHi with Fibocom L610-CN and usb0
if [ "$1" = "l610-t31-camhi" ]; then
	set_gpio 61 0
	modprobe rndis_host
	modprobe usbserial vendor=0x1782 product=0x4d11
	sleep 10
	echo "AT+GTRNDIS=1,2" >/dev/ttyUSB0
	exit 0
fi

# T31 CamHi with Fibocom L716-CN and usb0
if [ "$1" = "l716-t31-camhi" ]; then
	set_gpio 61 0
	modprobe rndis_host
	modprobe usbserial vendor=0x2cb7 product=0x0001
	sleep 10
	exit 0
fi

# SIMCOM7600G/SIMCOM7600G-H
# AK3918EV300L V380 PTZ (stock hwname V380E6_G1) with a Cat-1 module on USB:
# Quectel EC200S/T, EC600U, EC800G/K, Luat Air724UG/Air780E and others. The
# module is powered from GPIO 16, active high (wifi_power in its stock
# firmware's dev_gpio.cfg; the app drives it to module_pwr_reversal ^ 1, and
# module_pwr_reversal is 0). Data comes over RNDIS on usb0, or ECM on eth1.
# The kernel's option table lacks the EC600U (0903) and EC800G (0904) AT ports.
if [ "$1" = "rndis-ak3918ev300l-v380" ]; then
	set_gpio 16 1
	modprobe rndis_host
	modprobe cdc_ether
	modprobe option
	for id in "2c7c 0903" "2c7c 0904"; do
		echo "$id" > /sys/bus/usb-serial/drivers/option1/new_id
	done
	sleep 10
	exit 0
fi

if [ "$1" = "sim7600g" ]; then
	modprobe rndis_host
	modprobe option
	echo "1e0e 9011" > /sys/bus/usb-serial/drivers/option1/new_id
	sleep 5
	exit 0
fi

# EG25/EC25-xxx (RNDIS, AT+QCFG="usbnet",3)
if [ "$1" = "rndis-ec25" ]; then
	modprobe rndis_host
	modprobe option
	sleep 5
	exit 0
fi

# EG25/EC25-xxx (ECM, AT+QCFG="usbnet",1)
if [ "$1" = "ec25" ]; then
	modprobe option
	sleep 5
	exit 0
fi
exit 1
