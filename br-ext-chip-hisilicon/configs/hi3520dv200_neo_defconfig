# Architecture — single Cortex-A9 with NEON (same as hi3520dv200_lite)
BR2_arm=y
BR2_cortex_a9=y
BR2_ARM_EABI=y
BR2_ARM_FPU_NEON_VFPV3=y
BR2_ARM_INSTRUCTIONS_THUMB2=y

# Toolchain — reuse hi3520dv200_lite's musl toolchain (kernel headers 3.0;
# Linux keeps syscalls backward compatible, so they build cleanly against
# the 7.0 kernel).
BR2_TOOLCHAIN_EXTERNAL=y
BR2_TOOLCHAIN_EXTERNAL_CUSTOM=y
BR2_TOOLCHAIN_EXTERNAL_DOWNLOAD=y
BR2_TOOLCHAIN_EXTERNAL_URL="https://github.com/openipc/firmware/releases/download/$(OPENIPC_TOOLCHAIN).tgz"
BR2_TOOLCHAIN_EXTERNAL_CUSTOM_PREFIX="arm-openipc-linux-musleabi"
BR2_TOOLCHAIN_EXTERNAL_HEADERS_3_0=y
BR2_TOOLCHAIN_EXTERNAL_CUSTOM_MUSL=y
BR2_TOOLCHAIN_EXTERNAL_CXX=y

# Kernel — openipc/linux upstream-patches branch (same source as the other
# neo boards). Hi3520DV200 support (DT, mach-hibvt, hil2v200 L2, SATA glue,
# SFC v350, hisi-femac up port, SP805 restart) comes from openipc/linux
# PR #82; the board DT is hi3520dv200-nbd6808t.
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_TARBALL=y
BR2_LINUX_KERNEL_CUSTOM_TARBALL_LOCATION="https://github.com/openipc/linux/archive/upstream-patches.tar.gz"
BR2_LINUX_KERNEL_USE_CUSTOM_CONFIG=y
BR2_LINUX_KERNEL_CUSTOM_CONFIG_FILE="$(EXTERNAL_VENDOR)/board/$(OPENIPC_SOC_FAMILY)/hi3520dv200.neo.config"
BR2_LINUX_KERNEL_IMAGE_TARGET_CUSTOM=y
BR2_LINUX_KERNEL_IMAGE_TARGET_NAME="zImage"
BR2_LINUX_KERNEL_XZ=y

# Skip legacy kernel patches (3.0/4.9-era GCC compat, not needed for 7.0).
BR2_GLOBAL_PATCH_DIR="$(BR2_EXTERNAL)/package/all-patches-neo"

# Filesystem
BR2_PACKAGE_BUSYBOX_CONFIG="$(BR2_EXTERNAL)/package/busybox/busybox.config"
BR2_PACKAGE_UBOOT_TOOLS=y
BR2_PACKAGE_ZLIB=y
# BR2_PACKAGE_IFUPDOWN_SCRIPTS is not set
# Buildroot's wireguard-tools needs headers >= 3.10 and this toolchain
# ships 3.0; the kernel side is CONFIG_WIREGUARD=m.
BR2_PACKAGE_WIREGUARD_TOOLS_OPENIPC=y
# BR2_PACKAGE_WIREGUARD_LINUX_COMPAT is not set
BR2_TARGET_ROOTFS_CPIO=y
BR2_TARGET_ROOTFS_SQUASHFS=y
BR2_TARGET_ROOTFS_SQUASHFS4_XZ=y

# OpenIPC
BR2_OPENIPC_SOC_VENDOR="hisilicon"
BR2_OPENIPC_SOC_MODEL="hi3520dv200"
BR2_OPENIPC_SOC_FAMILY="hi3520dv200"
BR2_OPENIPC_VARIANT="neo"
BR2_OPENIPC_FLASH_SIZE="8"

# Packages. The vendor MPP (osdrv) is 3.0.8-only and has no 7.0 port, so this
# variant has no video pipeline: no osdrv, glibc-compat shim, opensdk or
# majestic. It is a headless recorder base with VGA through the
# bootloader-initialised simple-framebuffer. No Wi-Fi either: the kernel
# has no wireless stack, so wpa_supplicant and firmware would be dead weight.
BR2_PACKAGE_DROPBEAR_OPENIPC=y
BR2_PACKAGE_IPCTOOL=y
BR2_PACKAGE_LIBCURL_OPENIPC=y
BR2_PACKAGE_LIBCURL_OPENIPC_CURL=y
# BR2_PACKAGE_LIBCURL_OPENIPC_PROXY_SUPPORT is not set
# BR2_PACKAGE_LIBCURL_OPENIPC_COOKIES_SUPPORT is not set
# BR2_PACKAGE_LIBCURL_OPENIPC_EXTRA_PROTOCOLS_FEATURES is not set
BR2_PACKAGE_MBEDTLS_OPENIPC=y
BR2_PACKAGE_VTUND_OPENIPC=y
BR2_PACKAGE_XMDP=y
BR2_PACKAGE_YAML_CLI=y

# Post-image: wrap zImage + DTB into uImage so the 2010-era U-Boot's bootm works.
BR2_ROOTFS_POST_IMAGE_SCRIPT="$(EXTERNAL_VENDOR)/board/$(OPENIPC_SOC_FAMILY)/neo-post-image.sh"
