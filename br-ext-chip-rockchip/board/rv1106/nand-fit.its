/dts-v1/;

/* The NAND kernel: see general/scripts/rootfs_script.sh, the "NAND FIT" step. */
/ {
	/* "OpenIPC <soc>": sysupgrade's SoC check reads it (fit_soc). */
	description = "OpenIPC @SOC@";
	#address-cells = <1>;

	images {
		kernel {
			description = "Linux";
			data = /incbin/("zImage");
			type = "kernel";
			arch = "arm";
			os = "linux";
			compression = "none";
			load = <0x00208000>;
			entry = <0x00208000>;
			hash-1 { algo = "crc32"; };
			hash-2 { algo = "sha1"; };
		};

		fdt {
			description = "nand";
			data = /incbin/("@SOC@-nand.dtb");
			type = "flat_dt";
			arch = "arm";
			compression = "none";
			hash-1 { algo = "crc32"; };
			hash-2 { algo = "sha1"; };
		};
	};

	configurations {
		default = "conf-1";
		conf-1 {
			description = "Linux + nand";
			kernel = "kernel";
			fdt = "fdt";
		};
	};
};
